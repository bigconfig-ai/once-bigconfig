:80 {
	root * /srv

	handle /up {
		header Content-Type text/plain; charset=utf-8
		respond `OK` 200
	}

	handle {
		file_server
	}

	handle_errors {
		@notFound expression `{err.status_code} == 404`
		handle @notFound {
			rewrite * /404.html
			file_server
		}

		handle {
			respond `{err.status_code} {err.status_text}` {err.status_code}
		}
	}
}
