:80 {
	root * /srv

	handle /up {
		header Content-Type text/plain; charset=utf-8
		respond `OK` 200
	}

	handle {
		file_server
	}

	handle_errors {
		# The site is a single landing page. Everything that used to live here —
		# the blog, /manual, /once, /walter, the talks — 301s to it, so old
		# inbound links and search results keep working.
		# The matcher must sit on `redir` itself. Wrapping it as
		# `handle @notFound { redir / 301 }` passes `caddy validate` but emits a
		# bare 404 with no Location header at runtime.
		@notFound expression `{err.status_code} == 404`
		redir @notFound / 301

		@other expression `{err.status_code} != 404`
		respond @other `{err.status_code} {err.status_text}` {err.status_code}
	}
}
