---
const { class: className = "" } = Astro.props;
---

<div class={`bc-tabs ${className}`} data-bc-tabs>
  <slot />
</div>

<script is:inline>
  document.querySelectorAll("[data-bc-tabs]").forEach((tabs) => {
    if (tabs.dataset.ready === "true") return;
    const panels = Array.from(tabs.querySelectorAll(":scope > [data-bc-tab-panel]"));
    if (panels.length === 0) return;

    tabs.dataset.ready = "true";
    const tabList = document.createElement("div");
    tabList.className = "bc-tabs-list";
    tabList.setAttribute("role", "tablist");

    panels.forEach((panel, index) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "bc-tabs-button";
      button.textContent = panel.dataset.label || `Tab ${index + 1}`;
      button.setAttribute("role", "tab");

      const activate = () => {
        panels.forEach((item, itemIndex) => {
          const active = itemIndex === index;
          item.hidden = !active;
          tabList.children[itemIndex]?.setAttribute("aria-selected", String(active));
        });
      };

      button.addEventListener("click", activate);
      tabList.append(button);

      if (index !== 0) {
        panel.hidden = true;
      }
    });

    tabList.children[0]?.setAttribute("aria-selected", "true");
    tabs.prepend(tabList);
  });
</script>
