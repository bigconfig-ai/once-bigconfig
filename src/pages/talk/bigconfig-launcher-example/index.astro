---
import logo from "~/assets/logo-dark.svg";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#f8fafc" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="BigConfig Launcher" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>BigConfig Launcher Example — BigConfig</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/talk/bigconfig-launcher-example/manifest.webmanifest" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4VKP1WY4QJ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());
    gtag("config", "G-4VKP1WY4QJ");
  </script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@6.0.1/dist/reveal.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@6.0.1/dist/theme/white.css" id="theme" />
  <style>
    :root {
      --bc-blue: #0652e9;
      --bc-cyan: #0891b2;
      --bc-ink: #0f172a;
      --bc-muted: #475569;
      --bc-soft: #f8fafc;
      --bc-line: #e2e8f0;
    }

    * { box-sizing: border-box; }
    html,
    body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      overscroll-behavior: none;
      background: #f8fafc;
    }
    body {
      min-height: 100dvh;
      touch-action: manipulation;
    }
    button {
      background: transparent;
      border: 0;
      cursor: pointer;
      font: inherit;
      color: inherit;
    }
    pre { margin: 0; }

    .reveal {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      color: var(--bc-ink);
      font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    .reveal .slides { text-align: left; }
    .reveal .slides section.launcher-slide {
      height: 100%;
      padding:
        calc(30px + env(safe-area-inset-top))
        calc(38px + env(safe-area-inset-right))
        calc(30px + env(safe-area-inset-bottom))
        calc(38px + env(safe-area-inset-left));
    }

    .slide-shell {
      display: flex;
      min-height: 100%;
      flex-direction: column;
      gap: 18px;
    }
    .slide-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      border-bottom: 1px solid var(--bc-line);
      padding-bottom: 14px;
    }
    .brand {
      display: inline-flex;
      align-items: center;
    }
    .brand-logo {
      display: block;
      height: 36px;
      width: auto;
    }
    .slide-kicker {
      color: var(--bc-cyan);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .slide-main {
      display: grid;
      flex: 1;
      min-height: 0;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.18fr);
      gap: 26px;
      align-items: center;
    }
    .intro { min-width: 0; }
    .intro .eyebrow {
      display: inline-block;
      margin-bottom: 14px;
      color: var(--bc-cyan);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .intro h1 {
      margin: 0;
      color: var(--bc-ink);
      font-size: 43px;
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 0.98;
    }
    .intro p {
      margin: 18px 0 0;
      color: var(--bc-muted);
      font-size: 17px;
      line-height: 1.5;
    }
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 20px;
    }
    .chip {
      display: inline-flex;
      align-items: center;
      border: 1px solid #dbe4ee;
      border-radius: 999px;
      background: #fff;
      color: #334155;
      font-size: 13px;
      font-weight: 700;
      padding: 6px 10px;
      white-space: nowrap;
    }

    .launcher-panel {
      min-width: 0;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.92);
      box-shadow: 0 20px 55px rgba(15, 23, 42, 0.12);
      padding: 20px;
    }
    .choice-stack {
      display: grid;
      gap: 11px;
    }
    .choice-label {
      margin-bottom: 6px;
      color: #64748b;
      font-size: 10px;
      font-weight: 850;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .options {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }
    .command-option {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #cbd5e1;
      border-radius: 999px;
      background: #fff;
      color: #334155;
      font-size: 13px;
      font-weight: 750;
      line-height: 1;
      padding: 9px 12px;
      transition:
        background 150ms ease,
        border-color 150ms ease,
        color 150ms ease,
        box-shadow 150ms ease,
        transform 150ms ease;
      white-space: nowrap;
    }
    .command-option:hover {
      border-color: rgba(8, 145, 178, 0.55);
      background: #ecfeff;
      color: #0e7490;
      transform: translateY(-1px);
    }
    .command-option:focus-visible {
      border-color: rgba(8, 145, 178, 0.75);
      box-shadow: 0 0 0 3px rgba(8, 145, 178, 0.18);
      color: #0e7490;
      outline: none;
    }
    .command-option[aria-pressed="true"] {
      border-color: rgba(8, 145, 178, 0.75);
      background: #cffafe;
      color: #0e7490;
    }

    [data-credential="neutral"] {
      --credential-text: #475569;
      --credential-border: rgba(100, 116, 139, 0.42);
      --credential-hover-border: rgba(71, 85, 105, 0.72);
      --credential-bg: #f8fafc;
      --credential-hover-bg: #e2e8f0;
      --credential-selected-bg: #e2e8f0;
      --credential-selected-border: rgba(71, 85, 105, 0.78);
      --credential-ring: rgba(100, 116, 139, 0.2);
    }
    [data-credential="safe"] {
      --credential-text: #047857;
      --credential-border: rgba(16, 185, 129, 0.45);
      --credential-hover-border: rgba(4, 120, 87, 0.72);
      --credential-bg: #ecfdf5;
      --credential-hover-bg: #d1fae5;
      --credential-selected-bg: #a7f3d0;
      --credential-selected-border: rgba(4, 120, 87, 0.78);
      --credential-ring: rgba(16, 185, 129, 0.22);
    }
    [data-credential="danger"] {
      --credential-text: #be123c;
      --credential-border: rgba(244, 63, 94, 0.45);
      --credential-hover-border: rgba(190, 18, 60, 0.72);
      --credential-bg: #fff1f2;
      --credential-hover-bg: #ffe4e6;
      --credential-selected-bg: #fecdd3;
      --credential-selected-border: rgba(190, 18, 60, 0.78);
      --credential-ring: rgba(244, 63, 94, 0.22);
    }
    button.command-option[data-credential] {
      border-color: var(--credential-border);
      background: var(--credential-bg);
      color: var(--credential-text);
    }
    button.command-option[data-credential]:hover {
      border-color: var(--credential-hover-border);
      background: var(--credential-hover-bg);
      color: var(--credential-text);
    }
    button.command-option[data-credential]:focus-visible {
      border-color: var(--credential-hover-border);
      box-shadow: 0 0 0 3px var(--credential-ring);
      color: var(--credential-text);
    }
    button.command-option[data-credential][aria-pressed="true"] {
      border-color: var(--credential-selected-border);
      background: var(--credential-selected-bg);
      color: var(--credential-text);
    }

    .command-card {
      margin-top: 16px;
      overflow: hidden;
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      background: #0f172a;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }
    .command-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border-bottom: 1px solid rgba(226, 232, 240, 0.14);
      padding: 11px 13px;
    }
    .command-card-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }
    #launcher-command-label {
      color: #94a3b8;
      font-size: 10px;
      font-weight: 850;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    #launcher-credential-output[data-credential] {
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--credential-selected-border);
      border-radius: 999px;
      background: var(--credential-selected-bg);
      color: var(--credential-text);
      font-size: 11px;
      font-weight: 800;
      padding: 5px 8px;
      white-space: nowrap;
    }
    #launcher-copy {
      border: 1px solid rgba(226, 232, 240, 0.25);
      border-radius: 999px;
      color: #e2e8f0;
      font-size: 11px;
      font-weight: 800;
      padding: 6px 10px;
      transition: border-color 150ms ease, color 150ms ease, background 150ms ease;
    }
    #launcher-copy:hover,
    #launcher-copy:focus-visible {
      border-color: rgba(103, 232, 249, 0.75);
      background: rgba(103, 232, 249, 0.08);
      color: #67e8f9;
      outline: none;
    }
    #launcher-command {
      display: block;
      min-width: max-content;
      padding: 15px 16px;
      color: #e2e8f0;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 14px;
      line-height: 1.45;
      white-space: pre;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .slide-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--bc-line);
      color: #64748b;
      font-size: 12px;
      font-weight: 700;
      padding-top: 10px;
    }
    .slide-footer strong { color: var(--bc-ink); }
    .slide-footer a {
      color: var(--bc-blue);
      text-decoration: none;
    }
    .slide-footer a:hover,
    .slide-footer a:focus-visible {
      color: var(--bc-cyan);
      text-decoration: underline;
      outline: none;
    }

    @supports not (height: 100dvh) {
      body { min-height: 100vh; }
      .reveal { height: 100vh; }
    }

    @media (orientation: portrait) and (max-width: 900px) {
      .reveal {
        inset: auto;
        top: 50%;
        left: 50%;
        width: 100dvh;
        height: 100dvw;
        transform: translate(-50%, -50%) rotate(90deg);
        transform-origin: center center;
      }
    }

    @media (orientation: portrait) and (max-width: 900px) {
      @supports not (height: 100dvh) {
        .reveal {
          width: 100vh;
          height: 100vw;
        }
      }
    }

    @media (max-height: 500px), (orientation: portrait) and (max-width: 900px) {
      .reveal .slides section.launcher-slide {
        padding:
          calc(18px + env(safe-area-inset-top))
          calc(24px + env(safe-area-inset-right))
          calc(18px + env(safe-area-inset-bottom))
          calc(24px + env(safe-area-inset-left));
      }
      .slide-shell { gap: 10px; }
      .slide-header { padding-bottom: 8px; }
      .brand-logo { height: 30px; }
      .slide-kicker { font-size: 10px; }
      .slide-main {
        grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.28fr);
        gap: 18px;
      }
      .intro .eyebrow {
        margin-bottom: 10px;
        font-size: 10px;
      }
      .intro h1 { font-size: 36px; }
      .intro p {
        margin-top: 12px;
        font-size: 15px;
        line-height: 1.38;
      }
      .chips {
        gap: 6px;
        margin-top: 14px;
      }
      .chip {
        font-size: 11px;
        padding: 5px 8px;
      }
      .launcher-panel {
        border-radius: 18px;
        padding: 14px;
      }
      .choice-stack { gap: 7px; }
      .choice-label {
        margin-bottom: 4px;
        font-size: 8px;
      }
      .options { gap: 5px; }
      .command-option {
        font-size: 12px;
        padding: 7px 9px;
      }
      .command-card {
        margin-top: 10px;
        border-radius: 14px;
      }
      .command-card-header { padding: 8px 10px; }
      #launcher-command-label { font-size: 8px; }
      #launcher-credential-output[data-credential] {
        font-size: 9px;
        padding: 4px 6px;
      }
      #launcher-copy {
        font-size: 9px;
        padding: 5px 7px;
      }
      #launcher-command {
        font-size: 12px;
        line-height: 1.35;
        padding: 10px 12px;
      }
      .slide-footer {
        font-size: 10px;
        padding-top: 7px;
      }
    }
  </style>
</head>
<body>
  <div class="reveal">
    <div class="slides">
      <section class="launcher-slide" data-background-color="#f8fafc">
        <div id="launcher-example-slide" class="slide-shell">
          <header class="slide-header">
            <a href="/" class="brand" aria-label="BigConfig home"><img src={logo.src} alt="BigConfig" class="brand-logo" /></a>
            <div class="slide-kicker">Interactive launcher example</div>
          </header>

          <div class="slide-main">
            <div class="intro">
              <div class="eyebrow">Packages, verbs, shells, prompts</div>
              <h1>Generate a package command your agent can run.</h1>
              <p>
                Choose the launcher, package, target language, verb, and output environment.
                BigConfig turns those choices into either a shell command or an agent-ready
                prompt you can paste into your coding assistant.
              </p>
              <div class="chips" aria-label="Launcher capabilities">
                <span class="chip">uvx / npx</span>
                <span class="chip">once / walter / your package</span>
                <span class="chip">validate / build</span>
                <span class="chip">Shell / Prompt</span>
              </div>
            </div>

            <div class="launcher-panel">
              <div class="choice-stack">
                <div>
                  <div id="launcher-choice-label" class="choice-label">Launcher</div>
                  <div class="options" aria-labelledby="launcher-choice-label">
                    <button type="button" class="command-option" data-launcher="uvx" aria-pressed="false" aria-controls="launcher-command">uvx</button>
                    <button type="button" class="command-option" data-launcher="npx" aria-pressed="true" aria-controls="launcher-command">npx</button>
                  </div>
                </div>

                <div>
                  <div id="package-choice-label" class="choice-label">Package</div>
                  <div class="options" aria-labelledby="package-choice-label">
                    <button type="button" class="command-option" data-package="bigconfig-ai/once" aria-pressed="true" aria-controls="launcher-command">bigconfig-ai / once</button>
                    <button type="button" class="command-option" data-package="bigconfig-ai/walter" aria-pressed="false" aria-controls="launcher-command">bigconfig-ai / walter</button>
                    <button type="button" class="command-option" data-package="your/package" aria-pressed="false" aria-controls="launcher-command">your / package</button>
                  </div>
                </div>

                <div>
                  <div id="language-choice-label" class="choice-label">Target language</div>
                  <div class="options" aria-labelledby="language-choice-label">
                    <button type="button" class="command-option" data-language="typescript" aria-pressed="true" aria-controls="launcher-command">TypeScript</button>
                    <button type="button" class="command-option" data-language="python" aria-pressed="false" aria-controls="launcher-command">Python</button>
                    <button type="button" class="command-option" data-language="clojure" aria-pressed="false" aria-controls="launcher-command">Clojure</button>
                  </div>
                </div>

                <div>
                  <div id="verb-choice-label" class="choice-label">Verb</div>
                  <div class="options" aria-labelledby="verb-choice-label">
                    <button type="button" class="command-option" data-verb="validate" data-credential="safe" aria-pressed="true" aria-controls="launcher-command" aria-label="validate, read-only credentials">validate</button>
                    <button type="button" class="command-option" data-verb="build" data-credential="neutral" aria-pressed="false" aria-controls="launcher-command" aria-label="build, no credentials">build</button>
                    <button type="button" class="command-option" data-verb="create" data-credential="danger" aria-pressed="false" aria-controls="launcher-command" aria-label="create, read-write credentials">create</button>
                    <button type="button" class="command-option" data-verb="describe" data-credential="safe" aria-pressed="false" aria-controls="launcher-command" aria-label="describe, read-only credentials">describe</button>
                    <button type="button" class="command-option" data-verb="delete" data-credential="danger" aria-pressed="false" aria-controls="launcher-command" aria-label="delete, read-write credentials">delete</button>
                  </div>
                </div>

                <div>
                  <div id="environment-choice-label" class="choice-label">Environment</div>
                  <div class="options" aria-labelledby="environment-choice-label">
                    <button type="button" class="command-option" data-environment="shell" aria-pressed="false" aria-controls="launcher-command">Shell</button>
                    <button type="button" class="command-option" data-environment="prompt" aria-pressed="true" aria-controls="launcher-command">Prompt</button>
                  </div>
                </div>
              </div>

              <div class="command-card">
                <div class="command-card-header">
                  <div class="command-card-meta">
                    <span id="launcher-command-label">agent prompt</span>
                    <span id="launcher-credential-output" data-credential="safe" aria-live="polite">
                      <span id="launcher-credential-label">Read-only credentials</span>
                    </span>
                  </div>
                  <button id="launcher-copy" type="button">Copy</button>
                  <span id="launcher-copy-status" class="sr-only" aria-live="polite"></span>
                </div>
                <pre><code id="launcher-command">- run npx bc-pkg bigconfig-ai/once@typescript package validate
- iterate on failure</code></pre>
              </div>
            </div>
          </div>

          <footer class="slide-footer">
            <span><strong>BigConfig Launcher Example</strong></span>
            <a href="https://www.bigconfig.ai">bigconfig.ai</a>
          </footer>
        </div>
      </section>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/reveal.js@6.0.1/dist/reveal.js"></script>
  <script is:inline>
    const getVisualViewportSize = () => {
      const viewport = window.visualViewport;
      return {
        width: viewport?.width ?? window.innerWidth,
        height: viewport?.height ?? window.innerHeight,
      };
    };

    const getRevealViewport = () => {
      const { width, height } = getVisualViewportSize();
      const shortSide = Math.min(width, height);
      const isPhoneSized = shortSide <= 500;

      if (!isPhoneSized) {
        return { width: 1280, height: 720, margin: 0.02 };
      }

      const landscapeWidth = Math.max(width, height);
      const landscapeHeight = Math.min(width, height);
      const aspectRatio = landscapeWidth / landscapeHeight;

      return {
        width: 1280,
        height: Math.round(1280 / aspectRatio),
        margin: 0,
      };
    };

    const revealViewport = getRevealViewport();

    Reveal.initialize({
      hash: true,
      controls: true,
      progress: true,
      center: true,
      width: revealViewport.width,
      height: revealViewport.height,
      margin: revealViewport.margin,
      minScale: 0.2,
      maxScale: 2.0,
    });

    const relayoutReveal = () => {
      const nextViewport = getRevealViewport();
      Reveal.configure({
        width: nextViewport.width,
        height: nextViewport.height,
        margin: nextViewport.margin,
      });
      window.requestAnimationFrame(() => Reveal.layout());
    };

    window.addEventListener("resize", relayoutReveal);
    window.addEventListener("orientationchange", () => {
      window.setTimeout(relayoutReveal, 250);
    });
    window.visualViewport?.addEventListener("resize", relayoutReveal);

    if (
      window.matchMedia("(display-mode: standalone)").matches ||
      window.navigator.standalone
    ) {
      const landscapeLock = screen.orientation?.lock?.("landscape");
      landscapeLock?.catch?.(() => {});
    }

    const launcherExample = document.getElementById("launcher-example-slide");
    if (launcherExample) {
      const state = {
        launcher: "npx",
        packageName: "bigconfig-ai/once",
        language: "typescript",
        verb: "validate",
        environment: "prompt",
      };
      const credentialRequirements = {
        build: { label: "No credentials", kind: "neutral" },
        validate: { label: "Read-only credentials", kind: "safe" },
        describe: { label: "Read-only credentials", kind: "safe" },
        create: { label: "Read-write credentials", kind: "danger" },
        delete: { label: "Read-write credentials", kind: "danger" },
      };
      const commandEl = document.getElementById("launcher-command");
      const commandLabel = document.getElementById("launcher-command-label");
      const credentialOutput = document.getElementById("launcher-credential-output");
      const credentialLabel = document.getElementById("launcher-credential-label");
      const copyButton = document.getElementById("launcher-copy");
      const copyStatus = document.getElementById("launcher-copy-status");
      const launcherButtons = launcherExample.querySelectorAll("[data-launcher]");
      const packageButtons = launcherExample.querySelectorAll("[data-package]");
      const languageButtons = launcherExample.querySelectorAll("[data-language]");
      const verbButtons = launcherExample.querySelectorAll("[data-verb]");
      const environmentButtons = launcherExample.querySelectorAll("[data-environment]");
      let copyTimer;

      const getCommand = () =>
        `${state.launcher} bc-pkg ${state.packageName}@${state.language} package ${state.verb}`;

      const getDisplayText = () =>
        state.environment === "prompt"
          ? `- run ${getCommand()}\n- iterate on failure`
          : `$ ${getCommand()}`;

      const getCopyText = () =>
        state.environment === "prompt" ? getDisplayText() : getCommand();

      const getCommandLabel = () =>
        state.environment === "prompt" ? "agent prompt" : "shell command";

      const updateButtons = (buttons, key, value) => {
        buttons.forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            button.dataset[key] === value ? "true" : "false",
          );
        });
      };

      const resetCopyFeedback = () => {
        if (copyButton) copyButton.textContent = "Copy";
        if (copyStatus) copyStatus.textContent = "";
        window.clearTimeout(copyTimer);
      };

      const updateCredentialOutput = () => {
        const requirement =
          credentialRequirements[state.verb] ?? credentialRequirements.build;
        if (credentialOutput) {
          credentialOutput.setAttribute("data-credential", requirement.kind);
        }
        if (credentialLabel) credentialLabel.textContent = requirement.label;
      };

      const updateCommand = () => {
        if (commandEl) commandEl.textContent = getDisplayText();
        if (commandLabel) commandLabel.textContent = getCommandLabel();
        updateCredentialOutput();
        resetCopyFeedback();
      };

      const copyText = async (text) => {
        if (navigator.clipboard?.writeText && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return;
        }

        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.top = "-9999px";
        document.body.appendChild(textarea);
        textarea.select();
        const copied = document.execCommand("copy");
        document.body.removeChild(textarea);
        if (!copied) throw new Error("Copy command failed");
      };

      launcherButtons.forEach((button) => {
        button.addEventListener("click", () => {
          state.launcher = button.dataset.launcher;
          updateButtons(launcherButtons, "launcher", state.launcher);
          updateCommand();
        });
      });

      packageButtons.forEach((button) => {
        button.addEventListener("click", () => {
          state.packageName = button.dataset.package;
          updateButtons(packageButtons, "package", state.packageName);
          updateCommand();
        });
      });

      languageButtons.forEach((button) => {
        button.addEventListener("click", () => {
          state.language = button.dataset.language;
          updateButtons(languageButtons, "language", state.language);
          updateCommand();
        });
      });

      verbButtons.forEach((button) => {
        button.addEventListener("click", () => {
          state.verb = button.dataset.verb;
          updateButtons(verbButtons, "verb", state.verb);
          updateCommand();
        });
      });

      environmentButtons.forEach((button) => {
        button.addEventListener("click", () => {
          state.environment = button.dataset.environment;
          updateButtons(environmentButtons, "environment", state.environment);
          updateCommand();
        });
      });

      copyButton?.addEventListener("click", async () => {
        try {
          await copyText(getCopyText());
          copyButton.textContent = "Copied";
          if (copyStatus) copyStatus.textContent = "Command copied";
        } catch (error) {
          copyButton.textContent = "Copy failed";
          if (copyStatus) copyStatus.textContent = "Command copy failed";
        }

        window.clearTimeout(copyTimer);
        copyTimer = window.setTimeout(resetCopyFeedback, 1800);
      });

      updateCommand();
    }
  </script>
</body>
</html>
