---
import "~/styles/global.css";
import logo from "~/assets/logo-dark.svg";
import SeoMeta from "~/components/SeoMeta.astro";

const tagClass = (tag: string) =>
  tag === "Meetup Talk"
    ? "bg-blue-100 text-blue-800"
    : tag === "Demo"
      ? "bg-cyan-100 text-cyan-800"
      : tag === "Design Note"
        ? "bg-amber-100 text-amber-800"
        : "bg-green-100 text-green-800";

const talks = [
  {
    title: "Agentic DevOps with BigConfig — Tools Inside, Domain Verbs Outside",
    href: "/talk/agentic-devops-with-bigconfig/",
    description:
      "BigConfig turns operational procedures into executable, composable, testable, and versioned packages that run anywhere — from an AI agent, a human terminal, or CI/CD. Covers the executable-package model, the bc-pkg launcher, the open-source multi-language SDK, the agent authority boundary (read-only verbs for agents, writes gated behind the shell), and the Marketplace.",
    tags: ["Meetup Talk"],
    meta: "Alberto Miorin",
    slides: "~12 slides",
  },
  {
    title: "BigConfig: The First Agentic Package Manager",
    href: "/talk/agentic-devops/",
    description:
      "Meetup presentation at the Agentic DevOps Meetup (Jun 2026). Covers the YAML trap, the React analogy for infrastructure, BigConfig architecture, the agentic workflow, and the vision for natural language infrastructure.",
    tags: ["Meetup Talk"],
    meta: "Alberto Miorin · Valery Lavrentiev",
    slides: "~27 slides",
  },
  {
    title: "BigConfig Packages: Skills, but Executable",
    href: "/talk/bigconfig-packages-skills-but-executable/",
    description:
      "A full technical talk for Agentic DevOps leaders about skills, executable package contracts, bc-pkg, Once, and agent-safe operations.",
    tags: ["Meetup Talk"],
    meta: "Agentic DevOps leaders",
    slides: "46 slides",
  },
  {
    title: "BigConfig Launcher Example",
    href: "/talk/bigconfig-launcher-example/",
    description:
      "A single-slide interactive demo of the BigConfig launcher: choose a launcher, package, target language, verb, and output mode, then copy a shell command or agent-ready prompt with credential feedback.",
    tags: ["Demo"],
    meta: "Interactive launcher demo",
    slides: "1 slide",
  },
  {
    title: "DevOps Maturity Levels",
    href: "/talk/devops-maturity-levels/",
    description:
      "A design note exploring the four levels of DevOps maturity — from monolithic scripts (Level 01) to agent-friendly operations with validate and describe (Level 04). Includes the four-verb contract, validation gates, and the agent boundary.",
    tags: ["Design Note"],
    meta: "BigConfig Design Note",
    slides: "15 slides",
  },
  {
    title: "Agentic DevOps in Practice",
    href: "/talk/agentic-devops-in-practice/",
    description:
      "Based on the blog post. Covers the practical operating model: disposable Docker sandbox, read-only credentials, the four verbs (create, delete, validate, describe), ForceCommand as policy enforcement, and patterns vs anti-patterns.",
    tags: ["Design Note"],
    meta: "From blog post · May 2026",
    slides: "7 slides",
  },
  {
    title: "Agentic Workflow & Safety Model",
    href: "/talk/agentic-workflow-model/",
    description:
      "Combines the DevOps maturity levels and the agentic DevOps operating model into a single narrative. Starts with the maturity progression, then details the sandbox, agent loop, golden path, and ForceCommand boundary.",
    tags: ["Merged"],
    meta: "Merged from design notes",
    slides: "21 slides",
  },
  {
    title: "Full Talk: From DevOps Maturity to Agentic Operations",
    href: "/talk/full-agentic-devops-talk/",
    description:
      "The complete merged deck — combines the meetup talk with all design notes into one comprehensive presentation. Covers the problem, maturity journey, AI catalyst, BigConfig deep dive, agentic operating model, and vision.",
    tags: ["Meetup Talk", "Merged"],
    meta: "Full merge · 6 parts",
    slides: "~47 slides",
  },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Talks — BigConfig</title>
    <meta
      name="description"
      content="Slide decks, meetup presentations, and design notes about Agentic DevOps and BigConfig."
    />
    <SeoMeta
      title="Talks — BigConfig"
      description="Slide decks, meetup presentations, and design notes about Agentic DevOps and BigConfig."
      path="/talk/"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-4VKP1WY4QJ"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-4VKP1WY4QJ");
    </script>
    <style is:global>
      body {
        margin-top: 0;
        font-family:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
      }
      a {
        text-decoration: none;
      }
      :where(button) {
        background: transparent;
        border: 0;
        cursor: pointer;
        font: inherit;
        color: inherit;
      }
    </style>
  </head>
  <body class="bc-page-light antialiased">
    <div
      class="bc-page-glow"
    >
    </div>

    <!-- ============ HEADER / NAV ============ -->
    <div
      class="sticky top-0 z-50 border-b bc-site-header backdrop-blur-md"
    >
      <header
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
      >
        <a
          href="/"
          class="flex items-center gap-2 text-lg font-semibold tracking-tight text-slate-950"
        >
          <img src={logo.src} alt="" class="h-7 w-auto" />
        </a>
        <nav class="hidden gap-8 text-sm md:flex">
          <a
            href="https://marketplace.bigconfig.ai"
            class="bc-nav-link"
          >Marketplace ↗</a>
          <div class="bc-docs-dropdown group relative" data-docs-dropdown>
            <button
              type="button"
              class="flex items-center gap-1 bc-nav-link"
              aria-haspopup="true"
              aria-expanded="false"
              data-docs-dropdown-toggle
            >
              Docs
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="bc-docs-dropdown-icon h-3 w-3 transition group-hover:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </button>
            <div
              class="bc-docs-dropdown-menu invisible pointer-events-none absolute left-1/2 top-full z-50 w-44 -translate-x-1/2 pt-3 opacity-0 transition group-hover:visible group-hover:pointer-events-auto group-hover:opacity-100"
              data-docs-dropdown-menu
            >
              <div
                class="rounded-xl border border-slate-200 bg-white/95 p-2 shadow-xl shadow-slate-200/70 backdrop-blur"
              >
                <a
                  href="/manual/"
                  class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-100 hover:text-[#0652e9]"
                >Manual ↗</a>
                <a
                  href="/package-spec/"
                  class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-100 hover:text-[#0652e9]"
                >Package Spec ↗</a>
                <a
                  href="/talk"
                  class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-100 hover:text-[#0652e9]"
                >Talks</a>
              </div>
            </div>
          </div>
          <a
            href="/blog"
            class="bc-nav-link"
          >Blog</a>
        </nav>
        <a
          href="https://github.com/bigconfig-ai/big-config"
          class="hidden rounded-full bg-[#0652e9] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#1e6cf3] md:inline-block"
          style="color: #fff;"
        >
          GitHub
        </a>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-300 text-slate-800 transition hover:border-[#0652e9] hover:text-[#0652e9] md:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="mobile-menu-icon-open"
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
          <svg
            id="mobile-menu-icon-close"
            xmlns="http://www.w3.org/2000/svg"
            class="hidden h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 6l12 12M6 18L18 6"
            />
          </svg>
        </button>
      </header>
      <nav
        id="mobile-menu"
        class="hidden border-t border-slate-200 px-6 py-4 md:hidden"
      >
        <div class="flex flex-col gap-4 text-sm">
          <a
            href="https://marketplace.bigconfig.ai"
            class="bc-nav-link"
          >Marketplace ↗</a>
          <div class="flex flex-col gap-3">
            <button
              id="mobile-docs-toggle"
              type="button"
              class="flex w-full items-center justify-between text-left bc-nav-link"
              aria-expanded="false"
              aria-controls="mobile-docs-menu"
            >
              <span>Docs</span>
              <svg
                id="mobile-docs-icon"
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 transition"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </button>
            <div
              id="mobile-docs-menu"
              class="hidden flex-col gap-3 border-l border-slate-200 pl-4"
            >
              <a
                href="/manual/"
                class="bc-nav-link"
              >Manual ↗</a>
              <a href="/package-spec/" class="bc-nav-link">Package Spec ↗</a>
              <a href="/talk" class="bc-nav-link">Talks</a>
            </div>
          </div>
          <a href="/blog" class="bc-nav-link">Blog</a>
          <a
            href="https://github.com/bigconfig-ai/big-config"
            class="mt-2 rounded-full bg-[#0652e9] px-4 py-2 text-center font-semibold text-white transition hover:bg-[#1e6cf3]"
            style="color: #fff;"
          >
            GitHub
          </a>
        </div>
      </nav>
    </div>

    <!-- ============ HERO ============ -->
    <section class="mx-auto max-w-6xl px-6 pt-20 pb-16 text-center md:pt-24 md:pb-20">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-4 py-1.5 text-xs font-medium text-slate-600"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#62e1e9]"></span>
        Talks &amp; presentations
      </div>
      <h1
        class="mx-auto max-w-3xl text-4xl font-semibold tracking-tight text-slate-950 md:text-6xl"
      >
        Slide decks, meetup talks,<br />
        <span
          class="bg-gradient-to-r from-[#62e1e9] via-[#3a8cec] to-[#0652e9] bg-clip-text text-transparent"
        >and design notes</span>
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-slate-600">
        Presentations about Agentic DevOps, the DevOps maturity model, and the
        BigConfig operating model.
      </p>
    </section>

    <!-- ============ TALK CARDS ============ -->
    <section class="mx-auto max-w-6xl px-6 pb-24">
      <div class="grid gap-6 md:grid-cols-2">
        {
          talks.map((talk) => (
            <a
              href={talk.href}
              class="group flex flex-col rounded-2xl bc-site-card p-8 transition hover:border-[#62e1e9]/40 hover:bg-white"
            >
              <div class="flex gap-2 flex-wrap mb-3">
                {talk.tags.map((tag) => (
                  <span
                    class={`inline-block rounded-full px-3 py-0.5 text-xs font-semibold ${tagClass(tag)}`}
                  >{tag}</span>
                ))}
              </div>
              <h3
                class="text-lg font-semibold text-slate-950 group-hover:text-[#0891b2]"
              >
                {talk.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">
                {talk.description}
              </p>
              <div
                class="mt-5 flex items-center justify-between border-t border-slate-200 pt-4 text-xs text-slate-500"
              >
                <span>{talk.meta}</span>
                <span class="flex items-center gap-1">📽 {talk.slides}</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer
      class="mx-auto max-w-6xl px-6 py-12 text-center text-sm text-slate-500"
    >
      © {new Date().getFullYear()} BigConfig · <a
        href="/"
        class="bc-footer-link"
      >bigconfig.ai</a>
    </footer>

    <script is:inline>
      const mobileToggle = document.getElementById("mobile-menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("mobile-menu-icon-open");
      const iconClose = document.getElementById("mobile-menu-icon-close");
      const mobileDocsToggle = document.getElementById("mobile-docs-toggle");
      const mobileDocsMenu = document.getElementById("mobile-docs-menu");
      const mobileDocsIcon = document.getElementById("mobile-docs-icon");
      document.querySelectorAll("[data-docs-dropdown]").forEach((dropdown) => {
        if (!(dropdown instanceof HTMLElement)) return;
        const toggle = dropdown.querySelector("[data-docs-dropdown-toggle]");
        const menu = dropdown.querySelector("[data-docs-dropdown-menu]");
        if (!(toggle instanceof HTMLElement) || !(menu instanceof HTMLElement)) return;

        const setDocsDropdownOpen = (open) => {
          dropdown.classList.toggle("is-open", open);
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        };

        toggle.addEventListener("click", (event) => {
          event.preventDefault();
          setDocsDropdownOpen(toggle.getAttribute("aria-expanded") !== "true");
        });

        dropdown.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          setDocsDropdownOpen(false);
          toggle.focus();
        });

        dropdown.addEventListener("focusout", (event) => {
          const nextTarget = event.relatedTarget;
          if (!(nextTarget instanceof Node) || !dropdown.contains(nextTarget)) {
            setDocsDropdownOpen(false);
          }
        });

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (target instanceof Node && !dropdown.contains(target)) {
            setDocsDropdownOpen(false);
          }
        });

        menu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setDocsDropdownOpen(false));
        });
      });
      let setMobileDocsOpen = () => {};
      if (mobileDocsToggle && mobileDocsMenu) {
        setMobileDocsOpen = (open) => {
          mobileDocsMenu.classList.toggle("hidden", !open);
          mobileDocsMenu.classList.toggle("flex", open);
          mobileDocsToggle.setAttribute("aria-expanded", open ? "true" : "false");
          mobileDocsIcon?.classList.toggle("rotate-180", open);
        };
        mobileDocsToggle.addEventListener("click", () => {
          const isOpen = mobileDocsMenu.classList.contains("hidden");
          setMobileDocsOpen(isOpen);
        });
      }
      if (mobileToggle && mobileMenu) {
        const setOpen = (open) => {
          mobileMenu.classList.toggle("hidden", !open);
          mobileToggle.setAttribute("aria-expanded", open ? "true" : "false");
          iconOpen?.classList.toggle("hidden", open);
          iconClose?.classList.toggle("hidden", !open);
          if (!open) {
            setMobileDocsOpen(false);
          }
        };
        mobileToggle.addEventListener("click", () => {
          const isOpen = mobileMenu.classList.contains("hidden");
          setOpen(isOpen);
        });
        mobileMenu.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", () => setOpen(false));
        });
      }
    </script>
  </body>
</html>
