---
import BlogLayout from "~/layouts/BlogLayout.astro";
---

<BlogLayout title="Not Found - BigConfig" description="The requested page could not be found." canonical="/404.html">
  <section class="blog-shell">
    <p class="blog-eyebrow">404</p>
    <h1 class="blog-title">Page not found</h1>
    <p class="blog-description">The page may have moved. The manual and blog are the best places to continue.</p>
    <div class="blog-pagination">
      <a href="/manual">Manual</a>
      <a href="/blog/">Blog</a>
    </div>
  </section>
</BlogLayout>
