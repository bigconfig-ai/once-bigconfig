    <script is:inline>
      const mobileToggle = document.getElementById("mobile-menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("mobile-menu-icon-open");
      const iconClose = document.getElementById("mobile-menu-icon-close");
      const mobileDocsToggle = document.getElementById("mobile-docs-toggle");
      const mobileDocsMenu = document.getElementById("mobile-docs-menu");
      const mobileDocsIcon = document.getElementById("mobile-docs-icon");
      document.querySelectorAll("[data-docs-dropdown]").forEach((dropdown) => {
        if (!(dropdown instanceof HTMLElement)) return;
        const toggle = dropdown.querySelector("[data-docs-dropdown-toggle]");
        const menu = dropdown.querySelector("[data-docs-dropdown-menu]");
        if (!(toggle instanceof HTMLElement) || !(menu instanceof HTMLElement)) return;

        const setDocsDropdownOpen = (open) => {
          dropdown.classList.toggle("is-open", open);
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        };

        toggle.addEventListener("click", (event) => {
          event.preventDefault();
          setDocsDropdownOpen(toggle.getAttribute("aria-expanded") !== "true");
        });

        dropdown.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          setDocsDropdownOpen(false);
          toggle.focus();
        });

        dropdown.addEventListener("focusout", (event) => {
          const nextTarget = event.relatedTarget;
          if (!(nextTarget instanceof Node) || !dropdown.contains(nextTarget)) {
            setDocsDropdownOpen(false);
          }
        });

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (target instanceof Node && !dropdown.contains(target)) {
            setDocsDropdownOpen(false);
          }
        });

        menu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setDocsDropdownOpen(false));
        });
      });
      let setMobileDocsOpen = () => {};
      if (mobileDocsToggle && mobileDocsMenu) {
        setMobileDocsOpen = (open) => {
          mobileDocsMenu.classList.toggle("hidden", !open);
          mobileDocsMenu.classList.toggle("flex", open);
          mobileDocsToggle.setAttribute("aria-expanded", open ? "true" : "false");
          mobileDocsIcon?.classList.toggle("rotate-180", open);
        };
        mobileDocsToggle.addEventListener("click", () => {
          const isOpen = mobileDocsMenu.classList.contains("hidden");
          setMobileDocsOpen(isOpen);
        });
      }
      if (mobileToggle && mobileMenu) {
        const setOpen = (open) => {
          mobileMenu.classList.toggle("hidden", !open);
          mobileToggle.setAttribute("aria-expanded", open ? "true" : "false");
          iconOpen?.classList.toggle("hidden", open);
          iconClose?.classList.toggle("hidden", !open);
          if (!open) {
            setMobileDocsOpen(false);
          }
        };
        mobileToggle.addEventListener("click", () => {
          const isOpen = mobileMenu.classList.contains("hidden");
          setOpen(isOpen);
        });
        mobileMenu.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", () => setOpen(false));
        });
      }

      const launcherExample = document.getElementById("launcher-example");
      if (launcherExample) {
        const state = {
          launcher: "npx",
          packageName: "bigconfig-ai/once",
          language: "typescript",
          verb: "validate",
          environment: "prompt",
        };
        const credentialRequirements = {
          build: { label: "No credentials", kind: "neutral" },
          validate: { label: "Read-only credentials", kind: "safe" },
          describe: { label: "Read-only credentials", kind: "safe" },
          create: { label: "Read-write credentials", kind: "danger" },
          delete: { label: "Read-write credentials", kind: "danger" },
        };
        const commandEl = document.getElementById("launcher-command");
        const commandLabel = document.getElementById("launcher-command-label");
        const credentialOutput = document.getElementById("launcher-credential-output");
        const credentialLabel = document.getElementById("launcher-credential-label");
        const copyButton = document.getElementById("launcher-copy");
        const copyStatus = document.getElementById("launcher-copy-status");
        const launcherButtons = launcherExample.querySelectorAll("[data-launcher]");
        const packageButtons = launcherExample.querySelectorAll("[data-package]");
        const languageButtons = launcherExample.querySelectorAll("[data-language]");
        const verbButtons = launcherExample.querySelectorAll("[data-verb]");
        const environmentButtons = launcherExample.querySelectorAll("[data-environment]");
        let copyTimer;

        const getCommand = () =>
          `${state.launcher} bc-pkg ${state.packageName}@${state.language} package ${state.verb}`;

        const getDisplayText = () =>
          state.environment === "prompt"
            ? `- run ${getCommand()}\n- iterate on failure`
            : `$ ${getCommand()}`;

        const getCopyText = () =>
          state.environment === "prompt" ? getDisplayText() : getCommand();

        const getCommandLabel = () =>
          state.environment === "prompt" ? "agent prompt" : "shell command";

        const updateButtons = (buttons, key, value) => {
          buttons.forEach((button) => {
            button.setAttribute(
              "aria-pressed",
              button.dataset[key] === value ? "true" : "false",
            );
          });
        };

        const resetCopyFeedback = () => {
          if (copyButton) copyButton.textContent = "Copy";
          if (copyStatus) copyStatus.textContent = "";
          window.clearTimeout(copyTimer);
        };

        const updateCredentialOutput = () => {
          const requirement =
            credentialRequirements[state.verb] ?? credentialRequirements.build;
          if (credentialOutput) {
            credentialOutput.setAttribute("data-credential", requirement.kind);
          }
          if (credentialLabel) credentialLabel.textContent = requirement.label;
        };

        const updateCommand = () => {
          if (commandEl) commandEl.textContent = getDisplayText();
          if (commandLabel) commandLabel.textContent = getCommandLabel();
          updateCredentialOutput();
          resetCopyFeedback();
        };

        const copyText = async (text) => {
          if (navigator.clipboard?.writeText && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
            return;
          }

          const textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.top = "-9999px";
          document.body.appendChild(textarea);
          textarea.select();
          const copied = document.execCommand("copy");
          document.body.removeChild(textarea);
          if (!copied) throw new Error("Copy command failed");
        };

        launcherButtons.forEach((button) => {
          button.addEventListener("click", () => {
            state.launcher = button.dataset.launcher;
            updateButtons(launcherButtons, "launcher", state.launcher);
            updateCommand();
          });
        });

        packageButtons.forEach((button) => {
          button.addEventListener("click", () => {
            state.packageName = button.dataset.package;
            updateButtons(packageButtons, "package", state.packageName);
            updateCommand();
          });
        });

        languageButtons.forEach((button) => {
          button.addEventListener("click", () => {
            state.language = button.dataset.language;
            updateButtons(languageButtons, "language", state.language);
            updateCommand();
          });
        });

        verbButtons.forEach((button) => {
          button.addEventListener("click", () => {
            state.verb = button.dataset.verb;
            updateButtons(verbButtons, "verb", state.verb);
            updateCommand();
          });
        });

        environmentButtons.forEach((button) => {
          button.addEventListener("click", () => {
            state.environment = button.dataset.environment;
            updateButtons(environmentButtons, "environment", state.environment);
            updateCommand();
          });
        });

        copyButton?.addEventListener("click", async () => {
          try {
            await copyText(getCopyText());
            copyButton.textContent = "Copied";
            if (copyStatus) copyStatus.textContent = "Command copied";
          } catch (error) {
            copyButton.textContent = "Copy failed";
            if (copyStatus) copyStatus.textContent = "Command copy failed";
          }

          window.clearTimeout(copyTimer);
          copyTimer = window.setTimeout(resetCopyFeedback, 1800);
        });
      }

    </script>
  </body>
</html>
