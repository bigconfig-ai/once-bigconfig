---
import "~/styles/global.css";
import logo from "~/assets/logo-dark.svg";
import YouTube from "~/components/YouTube.astro";
import SeoMeta from "~/components/SeoMeta.astro";

const features = [
  {
    title: "Shell-native, not agent-trapped",
    body: "Skills make agents smarter. BigConfig makes procedures runnable. The same package runs from your terminal, your agent, your CI job, your cron, or another script — not just inside one chat product.",
    icon: "M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
  {
    title: "Software-grade reuse",
    body: "Packages are real software packages. They depend on libraries, share validation logic, abstract cloud providers, and version like code. Procedural knowledge stops drifting and starts compounding.",
    icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
  },
  {
    title: "A lifecycle contract",
    body: "Every package exposes the same verbs — validate, build, create, describe, delete — so credentials and authority can be scoped per action. Agents can safely describe and validate while humans stay in the loop for create and delete.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
  {
    title: "Durable, inspectable artifacts",
    body: "Packages render real files: Terraform plans, Ansible inventories, app configuration, lock files, validation reports. The outputs outlive the conversation and can be reviewed, diffed, and committed.",
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
];

const runtimes = [
  {
    title: "AI agent",
    body: "The agent inspects, describes, validates, and recommends — and asks before destructive verbs.",
    icon: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
  },
  {
    title: "Human in a terminal",
    body: "Operators run the same commands during incidents and routine work — no chat client required.",
    icon: "M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
  {
    title: "CI / CD",
    body: "Pipelines validate on every PR and run create or delete on protected branches with scoped credentials.",
    icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
  },
  {
    title: "Cron, scripts, containers",
    body: "Same binary, scheduled or wrapped. The package is just a command — anything that calls a command can call it.",
    icon: "M5 12V7a2 2 0 012-2h10a2 2 0 012 2v5M5 12h14M5 12v5a2 2 0 002 2h10a2 2 0 002-2v-5M9 8h.01M9 15h.01",
  },
];

const comparisonRows = [
  {
    q: "What is it?",
    skill: "Agent-native procedural knowledge",
    pkg: "Shell-native procedural knowledge",
  },
  {
    q: "Who can run it?",
    skill: "An agent with skill support",
    pkg: "Humans, agents, CI, scripts, containers",
  },
  {
    q: "Does it support library reuse?",
    skill: "Not as a first-class model",
    pkg: "Yes, through normal package dependencies",
  },
  {
    q: "What is the interface?",
    skill: "Agent instructions",
    pkg: "Executable commands and workflows",
  },
  {
    q: "What does it optimize for?",
    skill: "Making an agent better",
    pkg: "Making a procedure runnable and reusable",
  },
];

const links = [
  {
    title: "Marketplace",
    body: "Browse and install packages.",
    href: "https://marketplace.bigconfig.ai",
  },
  {
    title: "Manual",
    body: "Understand the launcher, package, SDK, and template stack.",
    href: "/manual",
  },
  {
    title: "Package Spec",
    body: "Implement a package that works with the launcher.",
    href: "/package-spec",
  },
  {
    title: "Blog",
    body: "Essays on agentic DevOps and the package model.",
    href: "/blog",
  },
];

---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BigConfig — The Open Agent Packages Ecosystem</title>
    <meta
      name="description"
      content="BigConfig is the Open Agent Packages Ecosystem. Packages are reusable units of procedural knowledge — like Skills, but executable — that your agent, your shell, and your CI can all run."
    />
    <SeoMeta
      title="BigConfig — The Open Agent Packages Ecosystem"
      description="BigConfig is the Open Agent Packages Ecosystem. Packages are reusable units of procedural knowledge — like Skills, but executable — that your agent, your shell, and your CI can all run."
      path="/"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-4VKP1WY4QJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-4VKP1WY4QJ");
    </script>
    <style is:global>
      body {
        margin-top: 0;
        font-family:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
      }
      a {
        text-decoration: none;
      }
      :where(button) {
        background: transparent;
        border: 0;
        cursor: pointer;
        font: inherit;
        color: inherit;
      }
      pre {
        margin: 0;
      }
      .command-option {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
        border: 1px solid #cbd5e1;
        border-radius: 9999px;
        background: #fff;
        color: #334155;
        padding: 0.625rem 1rem;
        transition:
          background 150ms ease,
          border-color 150ms ease,
          color 150ms ease,
          box-shadow 150ms ease;
      }
      .command-option:hover {
        background: #ecfeff;
        border-color: rgba(8, 145, 178, 0.55);
        color: #0e7490;
      }
      .command-option:focus-visible {
        border-color: rgba(8, 145, 178, 0.75);
        box-shadow: 0 0 0 3px rgba(8, 145, 178, 0.18);
        color: #0e7490;
        outline: none;
      }
      .command-option[aria-pressed="true"] {
        background: #cffafe;
        border-color: rgba(8, 145, 178, 0.75);
        color: #0e7490;
      }
      .package-tooltip-trigger {
        position: relative;
        display: inline-flex;
      }
      .package-tooltip-bubble {
        pointer-events: none;
        position: absolute;
        left: 50%;
        bottom: calc(100% + 0.75rem);
        z-index: 60;
        width: max-content;
        max-width: min(20rem, calc(100vw - 2rem));
        transform: translateX(-50%) translateY(0.25rem);
        border-radius: 0.875rem;
        background: #0f172a;
        color: #ffffff;
        padding: 0.75rem 0.875rem;
        font-size: 0.8125rem;
        line-height: 1.45;
        text-align: left;
        box-shadow: 0 18px 40px rgb(15 23 42 / 0.22);
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 150ms ease,
          transform 150ms ease,
          visibility 150ms ease;
      }
      .package-tooltip-bubble::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 100%;
        transform: translateX(-50%);
        border-width: 0.4rem 0.4rem 0;
        border-style: solid;
        border-color: #0f172a transparent transparent;
      }
      .package-tooltip-trigger:hover .package-tooltip-bubble,
      .package-tooltip-trigger:focus-within .package-tooltip-bubble {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
      }
      @media (max-width: 640px) {
        .package-tooltip-bubble {
          left: 0;
          transform: translateY(0.25rem);
        }
        .package-tooltip-bubble::after {
          left: 2rem;
          transform: none;
        }
        .package-tooltip-trigger:hover .package-tooltip-bubble,
        .package-tooltip-trigger:focus-within .package-tooltip-bubble {
          transform: translateY(0);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .package-tooltip-bubble {
          transition: none;
        }
      }
      [data-credential="neutral"] {
        --credential-text: #475569;
        --credential-border: rgba(100, 116, 139, 0.42);
        --credential-hover-border: rgba(71, 85, 105, 0.72);
        --credential-bg: #f8fafc;
        --credential-hover-bg: #e2e8f0;
        --credential-selected-bg: #e2e8f0;
        --credential-selected-border: rgba(71, 85, 105, 0.78);
        --credential-ring: rgba(100, 116, 139, 0.2);
      }
      [data-credential="safe"] {
        --credential-text: #047857;
        --credential-border: rgba(16, 185, 129, 0.45);
        --credential-hover-border: rgba(4, 120, 87, 0.72);
        --credential-bg: #ecfdf5;
        --credential-hover-bg: #d1fae5;
        --credential-selected-bg: #a7f3d0;
        --credential-selected-border: rgba(4, 120, 87, 0.78);
        --credential-ring: rgba(16, 185, 129, 0.22);
      }
      [data-credential="danger"] {
        --credential-text: #be123c;
        --credential-border: rgba(244, 63, 94, 0.45);
        --credential-hover-border: rgba(190, 18, 60, 0.72);
        --credential-bg: #fff1f2;
        --credential-hover-bg: #ffe4e6;
        --credential-selected-bg: #fecdd3;
        --credential-selected-border: rgba(190, 18, 60, 0.78);
        --credential-ring: rgba(244, 63, 94, 0.22);
      }
      button.command-option[data-credential] {
        background: var(--credential-bg);
        border-color: var(--credential-border);
        color: var(--credential-text);
      }
      button.command-option[data-credential]:hover {
        background: var(--credential-hover-bg);
        border-color: var(--credential-hover-border);
        color: var(--credential-text);
      }
      button.command-option[data-credential]:focus-visible {
        border-color: var(--credential-hover-border);
        box-shadow: 0 0 0 3px var(--credential-ring);
        color: var(--credential-text);
      }
      button.command-option[data-credential][aria-pressed="true"] {
        background: var(--credential-selected-bg);
        border-color: var(--credential-selected-border);
        color: var(--credential-text);
      }
      #launcher-credential-output[data-credential] {
        background: var(--credential-selected-bg);
        border-color: var(--credential-selected-border);
        color: var(--credential-text);
      }
    </style>
  </head>
  <body class="bc-page-light antialiased">
    <div
      class="bc-page-glow"
    >
    </div>

    <div
      class="sticky top-0 z-50 border-b bc-site-header backdrop-blur-md"
    >
      <header
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
      >
        <a
          href="/"
          class="flex items-center gap-2 text-lg font-semibold tracking-tight text-slate-950"
        >
          <img src={logo.src} alt="" class="h-7 w-auto" />
        </a>
        <nav class="hidden gap-8 text-sm md:flex">
          <a href="https://marketplace.bigconfig.ai" class="bc-nav-link">Marketplace ↗</a>
          <div class="bc-docs-dropdown group relative" data-docs-dropdown>
            <button
              type="button"
              class="flex items-center gap-1 bc-nav-link"
              aria-haspopup="true"
              aria-expanded="false"
              data-docs-dropdown-toggle
            >
              Docs
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="bc-docs-dropdown-icon h-3 w-3 transition group-hover:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div
              class="bc-docs-dropdown-menu invisible pointer-events-none absolute left-1/2 top-full z-50 w-44 -translate-x-1/2 pt-3 opacity-0 transition group-hover:visible group-hover:pointer-events-auto group-hover:opacity-100"
              data-docs-dropdown-menu
            >
              <div class="rounded-xl border border-slate-200 bg-white/95 p-2 shadow-xl shadow-slate-200/70 backdrop-blur">
                <a href="/manual/" class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-100 hover:text-[#0652e9]">Manual ↗</a>
                <a href="/package-spec/" class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-100 hover:text-[#0652e9]">Package Spec ↗</a>
                <a
                  href="/talk"
                  class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-100 hover:text-[#0652e9]"
                >Talks</a>
              </div>
            </div>
          </div>
          <a href="/blog" class="bc-nav-link">Blog</a>
        </nav>
        <a
          href="https://github.com/bigconfig-ai/big-config"
          class="hidden rounded-full bg-[#0652e9] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#1e6cf3] md:inline-block"
          style="color: #fff;"
        >
          GitHub
        </a>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-300 text-slate-800 transition hover:border-[#0652e9] hover:text-[#0652e9] md:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="mobile-menu-icon-open"
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg
            id="mobile-menu-icon-close"
            xmlns="http://www.w3.org/2000/svg"
            class="hidden h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6" />
          </svg>
        </button>
      </header>
      <nav
        id="mobile-menu"
        class="hidden border-t border-slate-200 px-6 py-4 md:hidden"
      >
        <div class="flex flex-col gap-4 text-sm">
          <a href="https://marketplace.bigconfig.ai" class="bc-nav-link">Marketplace ↗</a>
          <div class="flex flex-col gap-3">
            <button
              id="mobile-docs-toggle"
              type="button"
              class="flex w-full items-center justify-between text-left bc-nav-link"
              aria-expanded="false"
              aria-controls="mobile-docs-menu"
            >
              <span>Docs</span>
              <svg
                id="mobile-docs-icon"
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 transition"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div id="mobile-docs-menu" class="hidden flex-col gap-3 border-l border-slate-200 pl-4">
              <a href="/manual/" class="bc-nav-link">Manual ↗</a>
              <a href="/package-spec/" class="bc-nav-link">Package Spec ↗</a>
              <a href="/talk" class="bc-nav-link">Talks</a>
            </div>
          </div>
          <a href="/blog" class="bc-nav-link">Blog</a>
          <a
            href="https://github.com/bigconfig-ai/big-config"
            class="mt-2 rounded-full bg-[#0652e9] px-4 py-2 text-center font-semibold text-white transition hover:bg-[#1e6cf3]"
            style="color: #fff;"
          >
            GitHub
          </a>
        </div>
      </nav>
    </div>

    <!-- 1. Hero -->
    <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 text-center md:pt-20 md:pb-28">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-4 py-1.5 text-xs font-medium text-slate-600"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#62e1e9]"></span>
        TypeScript / Python / Clojure
      </div>
      <h1
        class="mx-auto max-w-4xl text-5xl font-semibold tracking-tight text-slate-950 md:text-7xl"
      >
        The Open<br />
        <span
          class="bg-gradient-to-r from-[#62e1e9] via-[#3a8cec] to-[#0652e9] bg-clip-text text-transparent"
          >Agent Packages Ecosystem</span
        >
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 md:text-xl">
        Like Skills, but executable. Packages turn procedural know-how — how to
        deploy, provision, validate, and tear down — into software your agent,
        your shell, and your CI can all run.
      </p>
    </section>

    <!-- 2. What is a package? -->
    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid gap-10 md:grid-cols-2 md:items-center">
        <div class="min-w-0">
          <div class="mb-4 inline-block text-xs font-semibold tracking-widest text-[#0891b2] uppercase">
            What is a package?
          </div>
          <h2 class="text-4xl font-semibold tracking-tight text-slate-950 md:text-5xl">
            Procedural knowledge, expressed as software.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-600">
            A package is a named, reusable unit of operational know-how — how
            to provision a server, configure DNS, render a Terraform plan,
            validate a deployment, and safely tear it down again.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">
            Skills give that knowledge to an agent. Packages give it to
            everyone: agents, humans in a terminal, CI pipelines, and scripts.
            Same procedure, one executable contract.
          </p>
        </div>
        <div class="min-w-0">
          <div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 shadow-2xl shadow-slate-900/20">
            <div class="flex items-center gap-2 border-b border-slate-800 px-4 py-3">
              <span class="h-3 w-3 rounded-full bg-rose-400"></span>
              <span class="h-3 w-3 rounded-full bg-amber-400"></span>
              <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
              <span class="ml-3 text-xs font-medium text-slate-400">bigconfig-ai/once</span>
            </div>
            <pre class="overflow-x-auto px-5 py-5 text-sm leading-relaxed text-slate-100"><code class="font-mono"><span class="text-slate-500">$</span> npx bc-pkg bigconfig-ai/once@typescript package <span class="text-emerald-300">validate</span>
<span class="text-slate-500">$</span> npx bc-pkg bigconfig-ai/once@typescript package <span class="text-rose-300">create</span>
<span class="text-slate-500">$</span> npx bc-pkg bigconfig-ai/once@typescript package <span class="text-rose-300">delete</span></code></pre>
          </div>
          <p class="mt-4 text-center text-sm text-slate-500">
            One package. One contract. Every runtime.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. Skills vs Packages -->
    <section class="mx-auto max-w-5xl px-6 py-24">
      <div class="mb-12 text-center">
        <div class="mb-4 inline-block text-xs font-semibold tracking-widest text-[#0891b2] uppercase">
          Skill or package?
        </div>
        <h2 class="text-4xl font-semibold tracking-tight text-slate-950 md:text-5xl">
          The same insight, packaged differently.
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-600">
          Both start from the idea that procedural knowledge should be
          reusable. They diverge on where that knowledge lives and how it runs.
        </p>
      </div>

      <div class="overflow-hidden rounded-2xl bc-site-card">
        <!-- Desktop / tablet table -->
        <table class="hidden w-full md:table">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50/60 text-left text-xs font-semibold tracking-widest text-slate-500 uppercase">
              <th class="px-6 py-4">Question</th>
              <th class="px-6 py-4">Skill</th>
              <th class="px-6 py-4">BigConfig package</th>
            </tr>
          </thead>
          <tbody>
            {
              comparisonRows.map((row, idx) => (
                <tr class={idx < comparisonRows.length - 1 ? "border-b border-slate-200" : ""}>
                  <td class="px-6 py-4 align-top text-sm font-semibold text-slate-950">{row.q}</td>
                  <td class="px-6 py-4 align-top text-sm text-slate-600">{row.skill}</td>
                  <td class="px-6 py-4 align-top text-sm text-slate-700">{row.pkg}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <!-- Mobile stacked cards -->
        <div class="divide-y divide-slate-200 md:hidden">
          {
            comparisonRows.map((row) => (
              <div class="px-6 py-5">
                <div class="text-xs font-semibold tracking-widest text-slate-500 uppercase">
                  {row.q}
                </div>
                <div class="mt-3 space-y-2 text-sm">
                  <div>
                    <span class="font-semibold text-slate-950">Skill — </span>
                    <span class="text-slate-600">{row.skill}</span>
                  </div>
                  <div>
                    <span class="font-semibold text-slate-950">Package — </span>
                    <span class="text-slate-700">{row.pkg}</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <p class="mt-6 text-center text-sm text-slate-500">
        Read the long form: <a href="/blog/skills-vs-bigconfig-packages/" class="font-semibold text-[#0891b2] hover:text-[#0652e9]">Skills vs. BigConfig Packages →</a>
      </p>
    </section>

    <!-- 4. Four differentiators -->
    <section id="features" class="mx-auto max-w-6xl px-6 py-20">
      <div class="mb-16 text-center">
        <div
          class="mb-4 inline-block text-xs font-semibold tracking-widest text-[#0891b2] uppercase"
        >
          Why packages
        </div>
        <h2 class="text-4xl font-semibold tracking-tight text-slate-950 md:text-5xl">
          What you get when procedures<br />become software.
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          features.map((f) => (
            <div class="group rounded-2xl bc-site-card p-8 transition hover:border-[#62e1e9]/40 hover:bg-white">
