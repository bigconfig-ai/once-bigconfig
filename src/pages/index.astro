---
import "~/styles/global.css";
import logo from "~/assets/logo-dark.svg";
import YouTube from "~/components/YouTube.astro";

const features = [
  {
    title: "Deploy in plain English",
    body: "Deploying non-trivial software is possible in English without writing a single line of code — hand your agent the generated prompt below.",
    icon: "M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z",
  },
  {
    title: "Master the Brownfield",
    body: "You don't need a \"greenfield\" project to see immediate value. BigConfig meets you where you are, automating legacy provisioning without the \"rip and replace\" headache. Ask your agent to convert your existing DevOps project to a BigConfig package.",
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "No Kubernetes? No Problem",
    body: "Escape the \"Kubernetes tax\". You shouldn't have to manage a complex K8s cluster just because a vendor distributed a tool via Helm. BigConfig empowers you to build packages tailored to your specific stack, giving you total sovereignty over your architecture.",
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  },
  {
    title: "Deploy Anything, Anywhere",
    body: "Stop over-provisioning infrastructure just to meet rigid software requirements. BigConfig lets you package applications to fit your existing environment—not the other way around.",
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
];

const links = [
  {
    title: "Marketplace",
    body: "Browse packages and deployment templates.",
    href: "https://marketplace.bigconfig.ai",
  },
  {
    title: "Documentation",
    body: "Getting started guides, tutorials, and reference.",
    href: "/manual",
  },
  {
    title: "Blog",
    body: "Articles about Agentic DevOps and BigConfig.",
    href: "/blog",
  },
  {
    title: "Support",
    body: "Consulting and training from the author.",
    href: "https://albertomiorin.com",
  },
];

---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BigConfig — The first agentic package manager</title>
    <meta
      name="description"
      content="BigConfig is the first package manager designed to work with agents out of the box."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-4VKP1WY4QJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-4VKP1WY4QJ");
    </script>
    <style is:global>
      body {
        margin-top: 0;
        font-family:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
      }
      a {
        text-decoration: none;
      }
      :where(button) {
        background: transparent;
        border: 0;
        cursor: pointer;
        font: inherit;
        color: inherit;
      }
      pre {
        margin: 0;
      }
      .command-option {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
        border: 1px solid #cbd5e1;
        border-radius: 9999px;
        background: #fff;
        color: #334155;
        padding: 0.625rem 1rem;
        transition:
          background 150ms ease,
          border-color 150ms ease,
          color 150ms ease,
          box-shadow 150ms ease;
      }
      .command-option:hover {
        background: #ecfeff;
        border-color: rgba(8, 145, 178, 0.55);
        color: #0e7490;
      }
      .command-option:focus-visible {
        border-color: rgba(8, 145, 178, 0.75);
        box-shadow: 0 0 0 3px rgba(8, 145, 178, 0.18);
        color: #0e7490;
        outline: none;
      }
      .command-option[aria-pressed="true"] {
        background: #cffafe;
        border-color: rgba(8, 145, 178, 0.75);
        color: #0e7490;
      }
      .package-tooltip-trigger {
        position: relative;
        display: inline-flex;
      }
      .package-tooltip-bubble {
        pointer-events: none;
        position: absolute;
        left: 50%;
        bottom: calc(100% + 0.75rem);
        z-index: 60;
        width: max-content;
        max-width: min(20rem, calc(100vw - 2rem));
        transform: translateX(-50%) translateY(0.25rem);
        border-radius: 0.875rem;
        background: #0f172a;
        color: #ffffff;
        padding: 0.75rem 0.875rem;
        font-size: 0.8125rem;
        line-height: 1.45;
        text-align: left;
        box-shadow: 0 18px 40px rgb(15 23 42 / 0.22);
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 150ms ease,
          transform 150ms ease,
          visibility 150ms ease;
      }
      .package-tooltip-bubble::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 100%;
        transform: translateX(-50%);
        border-width: 0.4rem 0.4rem 0;
        border-style: solid;
        border-color: #0f172a transparent transparent;
      }
      .package-tooltip-trigger:hover .package-tooltip-bubble,
      .package-tooltip-trigger:focus-within .package-tooltip-bubble {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
      }
      @media (max-width: 640px) {
        .package-tooltip-bubble {
          left: 0;
          transform: translateY(0.25rem);
        }
        .package-tooltip-bubble::after {
          left: 2rem;
          transform: none;
        }
        .package-tooltip-trigger:hover .package-tooltip-bubble,
        .package-tooltip-trigger:focus-within .package-tooltip-bubble {
          transform: translateY(0);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .package-tooltip-bubble {
          transition: none;
        }
      }
      [data-credential="neutral"] {
        --credential-text: #475569;
        --credential-border: rgba(100, 116, 139, 0.42);
        --credential-hover-border: rgba(71, 85, 105, 0.72);
        --credential-bg: #f8fafc;
        --credential-hover-bg: #e2e8f0;
        --credential-selected-bg: #e2e8f0;
        --credential-selected-border: rgba(71, 85, 105, 0.78);
        --credential-ring: rgba(100, 116, 139, 0.2);
      }
      [data-credential="safe"] {
        --credential-text: #047857;
        --credential-border: rgba(16, 185, 129, 0.45);
        --credential-hover-border: rgba(4, 120, 87, 0.72);
        --credential-bg: #ecfdf5;
        --credential-hover-bg: #d1fae5;
        --credential-selected-bg: #a7f3d0;
        --credential-selected-border: rgba(4, 120, 87, 0.78);
        --credential-ring: rgba(16, 185, 129, 0.22);
      }
      [data-credential="danger"] {
        --credential-text: #be123c;
        --credential-border: rgba(244, 63, 94, 0.45);
        --credential-hover-border: rgba(190, 18, 60, 0.72);
        --credential-bg: #fff1f2;
        --credential-hover-bg: #ffe4e6;
        --credential-selected-bg: #fecdd3;
        --credential-selected-border: rgba(190, 18, 60, 0.78);
        --credential-ring: rgba(244, 63, 94, 0.22);
      }
      button.command-option[data-credential] {
        background: var(--credential-bg);
        border-color: var(--credential-border);
        color: var(--credential-text);
      }
      button.command-option[data-credential]:hover {
        background: var(--credential-hover-bg);
        border-color: var(--credential-hover-border);
        color: var(--credential-text);
      }
      button.command-option[data-credential]:focus-visible {
        border-color: var(--credential-hover-border);
        box-shadow: 0 0 0 3px var(--credential-ring);
        color: var(--credential-text);
      }
      button.command-option[data-credential][aria-pressed="true"] {
        background: var(--credential-selected-bg);
        border-color: var(--credential-selected-border);
        color: var(--credential-text);
      }
      #launcher-credential-output[data-credential] {
        background: var(--credential-selected-bg);
        border-color: var(--credential-selected-border);
        color: var(--credential-text);
      }
    </style>
  </head>
  <body class="bc-page-light antialiased">
    <div
      class="bc-page-glow"
    >
    </div>

    <div
      class="sticky top-0 z-50 border-b bc-site-header backdrop-blur-md"
    >
      <header
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
      >
        <a
          href="/"
          class="flex items-center gap-2 text-lg font-semibold tracking-tight text-slate-950"
        >
          <img src={logo.src} alt="" class="h-7 w-auto" />
        </a>
        <nav class="hidden gap-8 text-sm md:flex">
          <a href="https://marketplace.bigconfig.ai" class="bc-nav-link">Marketplace ↗</a>
          <div class="group relative">
            <button
              type="button"
              class="flex items-center gap-1 bc-nav-link"
              aria-haspopup="true"
            >
              Docs
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3 w-3 transition group-hover:rotate-180 group-focus-within:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div
              class="invisible pointer-events-none absolute left-1/2 top-full z-50 w-44 -translate-x-1/2 pt-3 opacity-0 transition group-hover:visible group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:visible group-focus-within:pointer-events-auto group-focus-within:opacity-100"
            >
              <div class="rounded-xl border border-slate-200 bg-white/95 p-2 shadow-xl shadow-slate-200/70 backdrop-blur">
                <a href="/manual/" class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-100 hover:text-[#0652e9]">Manual ↗</a>
                <a
                  href="/talk"
                  class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-100 hover:text-[#0652e9]"
                >Talks</a>
              </div>
            </div>
          </div>
          <a href="/blog" class="bc-nav-link">Blog</a>
        </nav>
        <a
          href="https://github.com/bigconfig-ai/big-config"
          class="hidden rounded-full bg-[#0652e9] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#1e6cf3] md:inline-block"
        >
          GitHub
        </a>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-300 text-slate-800 transition hover:border-[#0652e9] hover:text-[#0652e9] md:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="mobile-menu-icon-open"
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg
            id="mobile-menu-icon-close"
            xmlns="http://www.w3.org/2000/svg"
            class="hidden h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6" />
          </svg>
        </button>
      </header>
      <nav
        id="mobile-menu"
        class="hidden border-t border-slate-200 px-6 py-4 md:hidden"
      >
        <div class="flex flex-col gap-4 text-sm">
          <a href="https://marketplace.bigconfig.ai" class="bc-nav-link">Marketplace ↗</a>
          <div class="flex flex-col gap-3">
            <button
              id="mobile-docs-toggle"
              type="button"
              class="flex w-full items-center justify-between text-left bc-nav-link"
              aria-expanded="false"
              aria-controls="mobile-docs-menu"
            >
              <span>Docs</span>
              <svg
                id="mobile-docs-icon"
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 transition"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div id="mobile-docs-menu" class="hidden flex-col gap-3 border-l border-slate-200 pl-4">
              <a href="/manual/" class="bc-nav-link">Manual ↗</a>
              <a href="/talk" class="bc-nav-link">Talks</a>
            </div>
          </div>
          <a href="/blog" class="bc-nav-link">Blog</a>
          <a
            href="https://github.com/bigconfig-ai/big-config"
            class="mt-2 rounded-full bg-[#0652e9] px-4 py-2 text-center font-semibold text-white transition hover:bg-[#1e6cf3]"
          >
            GitHub
          </a>
        </div>
      </nav>
    </div>

    <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 text-center md:pt-20 md:pb-28">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-4 py-1.5 text-xs font-medium text-slate-600"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#62e1e9]"></span>
        Agentic DevOps · TypeScript / Python / Clojure
      </div>
      <h1
        class="mx-auto max-w-4xl text-5xl font-semibold tracking-tight text-slate-950 md:text-7xl"
      >
        The first<br />
        <span
          class="bg-gradient-to-r from-[#62e1e9] via-[#3a8cec] to-[#0652e9] bg-clip-text text-transparent"
          >agentic package manager</span
        >
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 md:text-xl">
        You don't need to learn BigConfig, your agent can operate it for you.
      </p>
      <div
        class="mx-auto mt-10 flex max-w-md flex-col items-stretch justify-center gap-4 px-4 sm:max-w-none sm:flex-row sm:items-center sm:px-0"
      >
        <a
          href="https://marketplace.bigconfig.ai/"
          class="rounded-full bg-[#0652e9] px-8 py-4 text-center text-base font-semibold text-white transition hover:bg-[#1e6cf3]"
        >
          Marketplace →
        </a>
        <a
          href="https://github.com/bigconfig-ai/big-config"
          class="rounded-full border border-slate-300 px-8 py-4 text-center text-base font-semibold text-slate-700 transition hover:border-[#0652e9]/50 hover:text-[#0652e9]"
        >
          View on GitHub
        </a>
      </div>
    </section>

    <section id="launcher-example" class="mx-auto max-w-6xl px-6 py-24">
      <div class="grid min-w-0 gap-10 xl:grid-cols-[minmax(0,1fr)_minmax(42rem,1.25fr)] xl:items-center">
        <div class="min-w-0">
          <div
            class="mb-4 inline-block text-xs font-semibold tracking-widest text-[#0891b2] uppercase"
          >
            Packages, verbs, shells, prompts
          </div>
          <h2 class="text-4xl font-semibold tracking-tight text-slate-950 md:text-5xl">
            Generate a package command your agent can run.
          </h2>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600">
            Choose the launcher, package, target language, verb, and output
            environment. BigConfig turns those choices into either a shell
            command or an agent-ready prompt you can paste into your coding
            assistant.
          </p>
          <div class="mt-6 flex flex-wrap gap-2 text-sm text-slate-600">
            <span class="rounded-full border border-slate-200 bg-white/80 px-3 py-1">uvx / npx</span>
            <span class="rounded-full border border-slate-200 bg-white/80 px-3 py-1">once / walter / your package</span>
            <span class="rounded-full border border-slate-200 bg-white/80 px-3 py-1">validate / build</span>
            <span class="rounded-full border border-slate-200 bg-white/80 px-3 py-1">Shell / Prompt</span>
          </div>
        </div>

        <div class="min-w-0 rounded-2xl bc-site-card p-4 shadow-2xl shadow-slate-200/70 sm:p-6 md:p-8">
          <div class="space-y-6">
            <div>
              <div id="launcher-choice-label" class="mb-3 text-xs font-semibold tracking-widest text-slate-500 uppercase">
                Launcher
              </div>
              <div class="flex flex-wrap gap-2" aria-labelledby="launcher-choice-label">
                <button
                  type="button"
                  class="command-option"
                  data-launcher="uvx"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                >uvx</button>
                <button
                  type="button"
                  class="command-option"
                  data-launcher="npx"
                  aria-pressed="true"
                  aria-controls="launcher-command"
                >npx</button>
              </div>
            </div>

            <div>
              <div id="package-choice-label" class="mb-3 text-xs font-semibold tracking-widest text-slate-500 uppercase">
                Package
              </div>
              <div class="flex flex-wrap gap-2" aria-labelledby="package-choice-label">
                <span class="package-tooltip-trigger">
                  <button
                    type="button"
                    class="command-option"
                    data-package="bigconfig-ai/once"
                    aria-pressed="true"
                    aria-controls="launcher-command"
                    aria-describedby="package-once-tooltip"
                  >bigconfig-ai / once</button>
                  <span id="package-once-tooltip" role="tooltip" class="package-tooltip-bubble">
                    once is a package that automatically sets up everything needed to run a web application on a cloud server. It provisions the server, configures the domain name, sets up email sending, and deploys the app — in the right order, all with one command.
                  </span>
                </span>
                <span class="package-tooltip-trigger">
                  <button
                    type="button"
                    class="command-option"
                    data-package="bigconfig-ai/walter"
                    aria-pressed="false"
                    aria-controls="launcher-command"
                    aria-describedby="package-walter-tooltip"
                  >bigconfig-ai / walter</button>
                  <span id="package-walter-tooltip" role="tooltip" class="package-tooltip-bubble">
                    walter is a package that, from a single invocation, takes you from nothing to a fully provisioned, fully configured development machine in the cloud — the complete "set up my dev environment" workflow that handles both infrastructure (the VM itself) and configuration (everything installed and running on it), plus the ability to tear it all back down when you're done.
                  </span>
                </span>
                <span class="package-tooltip-trigger">
                  <button
                    type="button"
                    class="command-option"
                    data-package="your/package"
                    aria-pressed="false"
                    aria-controls="launcher-command"
                    aria-describedby="package-your-tooltip"
                  >your / package</button>
                  <span id="package-your-tooltip" role="tooltip" class="package-tooltip-bubble">
                    Turn your own deployment or setup workflow into a package your agent can understand, run, and iterate on. Start small with one repeatable task, then grow from there.
                  </span>
                </span>
              </div>
            </div>

            <div>
              <div id="language-choice-label" class="mb-3 text-xs font-semibold tracking-widest text-slate-500 uppercase">
                Target language
              </div>
              <div class="flex flex-wrap gap-2" aria-labelledby="language-choice-label">
                <button
                  type="button"
                  class="command-option"
                  data-language="typescript"
                  aria-pressed="true"
                  aria-controls="launcher-command"
                >TypeScript</button>
                <button
                  type="button"
                  class="command-option"
                  data-language="python"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                >Python</button>
                <button
                  type="button"
                  class="command-option"
                  data-language="clojure"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                >Clojure</button>
              </div>
            </div>

            <div>
              <div id="verb-choice-label" class="mb-3 text-xs font-semibold tracking-widest text-slate-500 uppercase">
                Verb
              </div>
              <div class="flex flex-wrap gap-2" aria-labelledby="verb-choice-label">
                <button
                  type="button"
                  class="command-option"
                  data-verb="validate"
                  data-credential="safe"
                  aria-pressed="true"
                  aria-controls="launcher-command"
                  aria-label="validate, read-only credentials"
                >validate</button>
                <button
                  type="button"
                  class="command-option"
                  data-verb="build"
                  data-credential="neutral"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                  aria-label="build, no credentials"
                >build</button>
                <button
                  type="button"
                  class="command-option"
                  data-verb="create"
                  data-credential="danger"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                  aria-label="create, read-write credentials"
                >create</button>
                <button
                  type="button"
                  class="command-option"
                  data-verb="describe"
                  data-credential="safe"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                  aria-label="describe, read-only credentials"
                >describe</button>
                <button
                  type="button"
                  class="command-option"
                  data-verb="delete"
                  data-credential="danger"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                  aria-label="delete, read-write credentials"
                >delete</button>
              </div>
            </div>

            <div>
              <div id="environment-choice-label" class="mb-3 text-xs font-semibold tracking-widest text-slate-500 uppercase">
                Environment
              </div>
              <div class="flex flex-wrap gap-2" aria-labelledby="environment-choice-label">
                <button
                  type="button"
                  class="command-option"
                  data-environment="shell"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                >Shell</button>
                <button
                  type="button"
                  class="command-option"
                  data-environment="prompt"
                  aria-pressed="true"
                  aria-controls="launcher-command"
                >Prompt</button>
              </div>
            </div>
          </div>

          <div class="mt-8 min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
              <div class="flex flex-wrap items-center gap-2">
                <span id="launcher-command-label" class="text-xs font-semibold tracking-widest text-slate-500 uppercase">agent prompt</span>
                <span
                  id="launcher-credential-output"
                  class="inline-flex items-center rounded-full border border-slate-200 bg-white/90 px-2.5 py-1 text-xs font-semibold text-slate-600"
                  data-credential="safe"
                  aria-live="polite"
                >
                  <span id="launcher-credential-label">Read-only credentials</span>
                </span>
              </div>
              <button
                id="launcher-copy"
                type="button"
                class="rounded-full border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-[#62e1e9]/60 hover:text-[#0891b2] focus-visible:border-[#0891b2] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0891b2]/30"
              >Copy</button>
              <span id="launcher-copy-status" class="sr-only" aria-live="polite"></span>
            </div>
            <pre class="w-full overflow-x-auto whitespace-pre p-4 text-sm leading-relaxed md:p-5"><code id="launcher-command" class="block min-w-max font-mono text-slate-700">- run npx bc-pkg bigconfig-ai/once@typescript package validate
- iterate on failure</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="mx-auto max-w-6xl px-6 py-20">
