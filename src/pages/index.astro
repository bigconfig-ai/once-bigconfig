---
import "~/styles/global.css";
import logo from "~/assets/logo-light.svg";
import YouTube from "~/components/YouTube.astro";

const features = [
  {
    title: "Deploy in plain English",
    body: "Deploying non-trivial software is possible in English without writing a single line of code — hand your agent the generated prompt below.",
    icon: "M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z",
  },
  {
    title: "Master the Brownfield",
    body: "You don't need a \"greenfield\" project to see immediate value. BigConfig meets you where you are, automating legacy provisioning without the \"rip and replace\" headache. Ask your agent to convert your existing DevOps project to a BigConfig package.",
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "No Kubernetes? No Problem",
    body: "Escape the \"Kubernetes tax\". You shouldn't have to manage a complex K8s cluster just because a vendor distributed a tool via Helm. BigConfig empowers you to build packages tailored to your specific stack, giving you total sovereignty over your architecture.",
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  },
  {
    title: "Deploy Anything, Anywhere",
    body: "Stop over-provisioning infrastructure just to meet rigid software requirements. BigConfig lets you package applications to fit your existing environment—not the other way around.",
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
];

const links = [
  {
    title: "Marketplace",
    body: "Browse packages and deployment templates.",
    href: "https://marketplace.bigconfig.ai",
  },
  {
    title: "Documentation",
    body: "Getting started guides, tutorials, and reference.",
    href: "/manual",
  },
  {
    title: "Blog",
    body: "Articles about Agentic DevOps and BigConfig.",
    href: "/blog",
  },
  {
    title: "Support",
    body: "Consulting and training from the author.",
    href: "https://albertomiorin.com",
  },
];

---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BigConfig — The first agentic package manager</title>
    <meta
      name="description"
      content="BigConfig is the first package manager designed to work with agents out of the box."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-4VKP1WY4QJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-4VKP1WY4QJ");
    </script>
    <style is:global>
      body {
        margin-top: 0;
        font-family:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
      }
      a {
        text-decoration: none;
      }
      :where(button) {
        background: transparent;
        border: 0;
        cursor: pointer;
        font: inherit;
        color: inherit;
      }
      pre {
        margin: 0;
      }
      .command-option {
        border: 1px solid rgb(38, 38, 38);
        border-radius: 9999px;
        color: rgb(212, 212, 212);
        padding: 0.625rem 1rem;
        transition:
          background 150ms ease,
          border-color 150ms ease,
          color 150ms ease,
          box-shadow 150ms ease;
      }
      .command-option:hover {
        border-color: rgba(98, 225, 233, 0.5);
        color: #fff;
      }
      .command-option:focus-visible {
        border-color: rgba(98, 225, 233, 0.75);
        box-shadow: 0 0 0 3px rgba(98, 225, 233, 0.18);
        color: #fff;
        outline: none;
      }
      .command-option[aria-pressed="true"] {
        background: rgba(98, 225, 233, 0.12);
        border-color: rgba(98, 225, 233, 0.65);
        color: #62e1e9;
      }
    </style>
  </head>
  <body class="bg-neutral-950 text-neutral-100 antialiased">
    <div
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_rgba(6,82,233,0.15),_transparent_60%)]"
    >
    </div>

    <div
      class="sticky top-0 z-50 border-b border-neutral-800/80 bg-neutral-950/85 backdrop-blur-md"
    >
      <header
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
      >
        <a
          href="/"
          class="flex items-center gap-2 text-lg font-semibold tracking-tight text-white"
        >
          <img src={logo.src} alt="" class="h-7 w-auto" />
        </a>
        <nav class="hidden gap-8 text-sm md:flex">
          <a href="https://marketplace.bigconfig.ai" class="text-white hover:text-[#62e1e9]">Marketplace ↗</a>
          <div class="group relative">
            <button
              type="button"
              class="flex items-center gap-1 text-white transition hover:text-[#62e1e9]"
              aria-haspopup="true"
            >
              Docs
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3 w-3 transition group-hover:rotate-180 group-focus-within:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div
              class="invisible pointer-events-none absolute left-1/2 top-full z-50 w-44 -translate-x-1/2 pt-3 opacity-0 transition group-hover:visible group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:visible group-focus-within:pointer-events-auto group-focus-within:opacity-100"
            >
              <div class="rounded-xl border border-neutral-800 bg-neutral-950/95 p-2 shadow-xl shadow-black/30 backdrop-blur">
                <a href="/manual/" class="block rounded-lg px-3 py-2 text-white hover:bg-neutral-900 hover:text-[#62e1e9]">Manual ↗</a>
                <a
                  href="/talk"
                  class="block rounded-lg px-3 py-2 text-white hover:bg-neutral-900 hover:text-[#62e1e9]"
                >Talks</a>
              </div>
            </div>
          </div>
          <a href="/blog" class="text-white hover:text-[#62e1e9]">Blog</a>
        </nav>
        <a
          href="https://github.com/bigconfig-ai/big-config"
          class="hidden rounded-full bg-[#0652e9] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#1e6cf3] md:inline-block"
        >
          GitHub
        </a>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-neutral-800 text-white md:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="mobile-menu-icon-open"
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg
            id="mobile-menu-icon-close"
            xmlns="http://www.w3.org/2000/svg"
            class="hidden h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6" />
          </svg>
        </button>
      </header>
      <nav
        id="mobile-menu"
        class="hidden border-t border-neutral-800/80 px-6 py-4 md:hidden"
      >
        <div class="flex flex-col gap-4 text-sm">
          <a href="https://marketplace.bigconfig.ai" class="text-white hover:text-[#62e1e9]">Marketplace ↗</a>
          <div class="flex flex-col gap-3">
            <button
              id="mobile-docs-toggle"
              type="button"
              class="flex w-full items-center justify-between text-left text-white transition hover:text-[#62e1e9]"
              aria-expanded="false"
              aria-controls="mobile-docs-menu"
            >
              <span>Docs</span>
              <svg
                id="mobile-docs-icon"
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 transition"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div id="mobile-docs-menu" class="hidden flex-col gap-3 border-l border-neutral-800 pl-4">
              <a href="/manual/" class="text-white hover:text-[#62e1e9]">Manual ↗</a>
              <a href="/talk" class="text-white hover:text-[#62e1e9]">Talks</a>
            </div>
          </div>
          <a href="/blog" class="text-white hover:text-[#62e1e9]">Blog</a>
          <a
            href="https://github.com/bigconfig-ai/big-config"
            class="mt-2 rounded-full bg-[#0652e9] px-4 py-2 text-center font-semibold text-white transition hover:bg-[#1e6cf3]"
          >
            GitHub
          </a>
        </div>
      </nav>
    </div>

    <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 text-center md:pt-20 md:pb-28">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-neutral-800 bg-neutral-900/60 px-4 py-1.5 text-xs font-medium text-neutral-300"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#62e1e9]"></span>
        Agentic DevOps · TypeScript / Python / Clojure
      </div>
      <h1
        class="mx-auto max-w-4xl text-5xl font-semibold tracking-tight text-white md:text-7xl"
      >
        The first<br />
        <span
          class="bg-gradient-to-r from-[#62e1e9] via-[#3a8cec] to-[#0652e9] bg-clip-text text-transparent"
          >agentic package manager</span
        >
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-300 md:text-xl">
        You don't need to learn BigConfig, your agent can operate it for you.
      </p>
      <div
        class="mx-auto mt-10 flex max-w-md flex-col items-stretch justify-center gap-4 px-4 sm:max-w-none sm:flex-row sm:items-center sm:px-0"
      >
        <a
          href="https://marketplace.bigconfig.ai/"
          class="rounded-full bg-[#0652e9] px-8 py-4 text-center text-base font-semibold text-white transition hover:bg-[#1e6cf3]"
        >
          Marketplace →
        </a>
        <a
          href="https://github.com/bigconfig-ai/big-config"
          class="rounded-full border border-neutral-700 px-8 py-4 text-center text-base font-semibold text-neutral-200 transition hover:border-neutral-500 hover:text-white"
        >
          View on GitHub
        </a>
      </div>
    </section>

    <section id="launcher-example" class="mx-auto max-w-6xl px-6 py-24">
      <div class="grid min-w-0 gap-10 xl:grid-cols-[minmax(0,1fr)_minmax(42rem,1.25fr)] xl:items-center">
        <div class="min-w-0">
          <div
            class="mb-4 inline-block text-xs font-semibold tracking-widest text-[#62e1e9] uppercase"
          >
            Three languages, either launcher
          </div>
          <h2 class="text-4xl font-semibold tracking-tight text-white md:text-5xl">
            Let your agents develop packages in TypeScript, Python, or Clojure.
          </h2>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-neutral-400">
            BigConfig packages can target the runtime your team already uses.
            Choose the npm launcher with <code
              class="rounded bg-neutral-800 px-1.5 py-0.5 font-mono text-sm text-[#62e1e9]"
              >npx</code
            > or the Python launcher with <code
              class="rounded bg-neutral-800 px-1.5 py-0.5 font-mono text-sm text-[#62e1e9]"
              >uvx</code
            >, then point it at the TypeScript, Python, or Clojure implementation.
          </p>
          <div class="mt-6 flex flex-wrap gap-2 text-sm text-neutral-300">
            <span class="rounded-full border border-neutral-800 bg-neutral-900/60 px-3 py-1">TypeScript</span>
            <span class="rounded-full border border-neutral-800 bg-neutral-900/60 px-3 py-1">Python</span>
            <span class="rounded-full border border-neutral-800 bg-neutral-900/60 px-3 py-1">Clojure</span>
          </div>
        </div>

        <div class="min-w-0 rounded-2xl border border-neutral-800 bg-neutral-900/40 p-4 shadow-2xl shadow-black/20 sm:p-6 md:p-8">
          <div class="space-y-6">
            <div>
              <div id="launcher-choice-label" class="mb-3 text-xs font-semibold tracking-widest text-neutral-500 uppercase">
                Launcher
              </div>
              <div class="flex flex-wrap gap-2" aria-labelledby="launcher-choice-label">
                <button
                  type="button"
                  class="command-option"
                  data-launcher="uvx"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                >uvx</button>
                <button
                  type="button"
                  class="command-option"
                  data-launcher="npx"
                  aria-pressed="true"
                  aria-controls="launcher-command"
                >npx</button>
              </div>
            </div>

            <div>
              <div id="language-choice-label" class="mb-3 text-xs font-semibold tracking-widest text-neutral-500 uppercase">
                Target language
              </div>
              <div class="flex flex-wrap gap-2" aria-labelledby="language-choice-label">
                <button
                  type="button"
                  class="command-option"
                  data-language="typescript"
                  aria-pressed="true"
                  aria-controls="launcher-command"
                >TypeScript</button>
                <button
                  type="button"
                  class="command-option"
                  data-language="python"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                >Python</button>
                <button
                  type="button"
                  class="command-option"
                  data-language="clojure"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                >Clojure</button>
              </div>
            </div>

            <div>
              <div id="environment-choice-label" class="mb-3 text-xs font-semibold tracking-widest text-neutral-500 uppercase">
                Environment
              </div>
              <div class="flex flex-wrap gap-2" aria-labelledby="environment-choice-label">
                <button
                  type="button"
                  class="command-option"
                  data-environment="shell"
                  aria-pressed="false"
                  aria-controls="launcher-command"
                >Shell</button>
                <button
                  type="button"
                  class="command-option"
                  data-environment="prompt"
                  aria-pressed="true"
                  aria-controls="launcher-command"
                >Prompt</button>
              </div>
            </div>
          </div>

          <div class="mt-8 min-w-0 overflow-hidden rounded-xl border border-neutral-800 bg-black/40">
            <div class="flex items-center justify-between gap-4 border-b border-neutral-800 px-4 py-3">
              <span id="launcher-command-label" class="text-xs font-semibold tracking-widest text-neutral-500 uppercase">agent prompt</span>
              <button
                id="launcher-copy"
                type="button"
                class="rounded-full border border-neutral-700 px-3 py-1.5 text-xs font-semibold text-neutral-200 transition hover:border-[#62e1e9]/60 hover:text-[#62e1e9] focus-visible:border-[#62e1e9] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#62e1e9]/30"
              >Copy</button>
              <span id="launcher-copy-status" class="sr-only" aria-live="polite"></span>
            </div>
            <pre class="w-full overflow-x-auto whitespace-pre p-4 text-sm leading-relaxed md:p-5"><code id="launcher-command" class="block min-w-max font-mono text-neutral-200">- run npx bc-pkg bigconfig-ai/once@typescript package validate
- iterate on failure</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="mx-auto max-w-6xl px-6 py-20">
      <div class="mb-16 text-center">
        <div
          class="mb-4 inline-block text-xs font-semibold tracking-widest text-[#62e1e9] uppercase"
        >
          Why BigConfig
        </div>
        <h2 class="text-4xl font-semibold tracking-tight text-white md:text-5xl">
          Built for your agent<br />that will operate it.
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          features.map((f) => (
            <div class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-8 transition hover:border-[#62e1e9]/40 hover:bg-neutral-900">
              <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-lg bg-[#62e1e9]/10 text-[#62e1e9] ring-1 ring-[#62e1e9]/20">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d={f.icon}
                  />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-white">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-400">
                {f.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section id="demo" class="mx-auto max-w-6xl px-6 py-24">
      <div class="mb-12 text-center">
        <div
          class="mb-4 inline-block text-xs font-semibold tracking-widest text-[#62e1e9] uppercase"
        >
          Demo
        </div>
        <h2 class="text-4xl font-semibold tracking-tight text-white md:text-5xl">
          See it in action.
        </h2>
      </div>

      <div
        class="overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900/40"
      >
        <YouTube id="wTwMJpn6zhc" si="qkjlqMknaG461nYd" />
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-24">
      <div class="mb-16 text-center">
        <div
          class="mb-4 inline-block text-xs font-semibold tracking-widest text-[#62e1e9] uppercase"
        >
          Dive deeper
        </div>
        <h2 class="text-4xl font-semibold tracking-tight text-white md:text-5xl">
          Start here.
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="group flex flex-col rounded-2xl border border-neutral-800 bg-neutral-900/40 p-8 transition hover:border-[#62e1e9]/40 hover:bg-neutral-900"
            >
              <h3 class="text-lg font-semibold text-white group-hover:text-[#62e1e9]">
                {l.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-400">
                {l.body}
              </p>
              <div class="mt-4 text-sm font-semibold text-[#62e1e9]">
                Open →
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <footer
      class="mx-auto max-w-6xl px-6 py-12 text-center text-sm text-neutral-500"
    >
      © {new Date().getFullYear()} BigConfig · <a
        href="/"
        class="text-white hover:text-neutral-300">bigconfig.ai</a
      >
    </footer>

    <script is:inline>
      const mobileToggle = document.getElementById("mobile-menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("mobile-menu-icon-open");
      const iconClose = document.getElementById("mobile-menu-icon-close");
      const mobileDocsToggle = document.getElementById("mobile-docs-toggle");
      const mobileDocsMenu = document.getElementById("mobile-docs-menu");
      const mobileDocsIcon = document.getElementById("mobile-docs-icon");
      let setMobileDocsOpen = () => {};
      if (mobileDocsToggle && mobileDocsMenu) {
        setMobileDocsOpen = (open) => {
          mobileDocsMenu.classList.toggle("hidden", !open);
          mobileDocsMenu.classList.toggle("flex", open);
          mobileDocsToggle.setAttribute("aria-expanded", open ? "true" : "false");
          mobileDocsIcon?.classList.toggle("rotate-180", open);
        };
        mobileDocsToggle.addEventListener("click", () => {
          const isOpen = mobileDocsMenu.classList.contains("hidden");
          setMobileDocsOpen(isOpen);
        });
      }
      if (mobileToggle && mobileMenu) {
        const setOpen = (open) => {
          mobileMenu.classList.toggle("hidden", !open);
          mobileToggle.setAttribute("aria-expanded", open ? "true" : "false");
          iconOpen?.classList.toggle("hidden", open);
          iconClose?.classList.toggle("hidden", !open);
          if (!open) {
            setMobileDocsOpen(false);
          }
        };
        mobileToggle.addEventListener("click", () => {
          const isOpen = mobileMenu.classList.contains("hidden");
          setOpen(isOpen);
        });
        mobileMenu.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", () => setOpen(false));
        });
      }

      const launcherExample = document.getElementById("launcher-example");
      if (launcherExample) {
        const state = { launcher: "npx", language: "typescript", environment: "prompt" };
        const commandEl = document.getElementById("launcher-command");
        const commandLabel = document.getElementById("launcher-command-label");
        const copyButton = document.getElementById("launcher-copy");
        const copyStatus = document.getElementById("launcher-copy-status");
        const launcherButtons = launcherExample.querySelectorAll("[data-launcher]");
        const languageButtons = launcherExample.querySelectorAll("[data-language]");
        const environmentButtons = launcherExample.querySelectorAll("[data-environment]");
        let copyTimer;

        const getCommand = () =>
          `${state.launcher} bc-pkg bigconfig-ai/once@${state.language} package validate`;

        const getDisplayText = () =>
          state.environment === "prompt"
            ? `- run ${getCommand()}\n- iterate on failure`
            : `$ ${getCommand()}`;

        const getCommandLabel = () =>
          state.environment === "prompt" ? "agent prompt" : "shell command";

        const updateButtons = (buttons, key, value) => {
          buttons.forEach((button) => {
            button.setAttribute(
              "aria-pressed",
              button.dataset[key] === value ? "true" : "false",
            );
          });
        };

        const resetCopyFeedback = () => {
          if (copyButton) copyButton.textContent = "Copy";
          if (copyStatus) copyStatus.textContent = "";
          window.clearTimeout(copyTimer);
        };

        const updateCommand = () => {
          if (commandEl) commandEl.textContent = getDisplayText();
          if (commandLabel) commandLabel.textContent = getCommandLabel();
          resetCopyFeedback();
        };

        const copyText = async (text) => {
          if (navigator.clipboard?.writeText && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
            return;
          }

          const textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.top = "-9999px";
          document.body.appendChild(textarea);
          textarea.select();
          const copied = document.execCommand("copy");
          document.body.removeChild(textarea);
          if (!copied) throw new Error("Copy command failed");
        };

        launcherButtons.forEach((button) => {
          button.addEventListener("click", () => {
            state.launcher = button.dataset.launcher;
            updateButtons(launcherButtons, "launcher", state.launcher);
            updateCommand();
          });
        });

        languageButtons.forEach((button) => {
          button.addEventListener("click", () => {
            state.language = button.dataset.language;
            updateButtons(languageButtons, "language", state.language);
            updateCommand();
          });
        });

        environmentButtons.forEach((button) => {
          button.addEventListener("click", () => {
            state.environment = button.dataset.environment;
            updateButtons(environmentButtons, "environment", state.environment);
            updateCommand();
          });
        });

        copyButton?.addEventListener("click", async () => {
          try {
            await copyText(getDisplayText());
            copyButton.textContent = "Copied";
            if (copyStatus) copyStatus.textContent = "Command copied";
          } catch (error) {
            copyButton.textContent = "Copy failed";
            if (copyStatus) copyStatus.textContent = "Command copy failed";
          }

          window.clearTimeout(copyTimer);
          copyTimer = window.setTimeout(resetCopyFeedback, 1800);
        });
      }

    </script>
  </body>
</html>
