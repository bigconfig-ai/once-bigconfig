---
import { render } from "astro:content";
import BlogLayout from "~/layouts/BlogLayout.astro";
import {
  formatDate,
  getBlogPosts,
  getPostCover,
  getPostExcerpt,
  getPostTags,
  normalizeAuthors,
  slugify,
  type BlogPost,
} from "~/lib/blog";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogPost };
const { Content } = await render(post);
const cover = getPostCover(post);
const description = getPostExcerpt(post);
---

<BlogLayout title={`${post.data.title} - BigConfig`} description={description} canonical={post.url} image={cover.image}>
  <article class="blog-article">
    <header class="blog-article-header">
      <p class="blog-eyebrow">Blog</p>
      <h1>{post.data.title}</h1>
      <div class="blog-meta">
        {formatDate(post.data.date)}
        {" "}
        by
        {" "}
        {normalizeAuthors(post.data.authors).map((author, index) => (
          <>
            {index > 0 && ", "}
            <a href={`/blog/authors/${author}/`}>{author}</a>
          </>
        ))}
      </div>
      <div class="blog-tags">
        {getPostTags(post).map((tag) => <a href={`/blog/tags/${slugify(tag)}/`}>{tag}</a>)}
      </div>
    </header>

    {cover.image && <img class="blog-cover" src={cover.image} alt={cover.alt} />}

    <div class="blog-prose">
      <Content />
    </div>
  </article>
</BlogLayout>
