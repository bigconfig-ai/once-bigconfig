---
import BlogLayout from "~/layouts/BlogLayout.astro";
import {
  formatDate,
  getBlogPosts,
  getPostCover,
  getPostExcerpt,
  getPostTags,
  getTags,
  slugify,
} from "~/lib/blog";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return getTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const allPosts = await getBlogPosts();
const posts = allPosts.filter((post) => getPostTags(post).some((item) => slugify(item) === tag.slug));
---

<BlogLayout title={`${tag.label} - BigConfig Blog`} description={`Posts tagged ${tag.label}.`} canonical={`/blog/tags/${tag.slug}/`}>
  <section class="blog-shell">
    <p class="blog-eyebrow">Tag</p>
    <h1 class="blog-title">{tag.label}</h1>
    <p class="blog-description">{posts.length} posts tagged {tag.label}.</p>

    <div class="blog-list">
      {posts.map((post) => {
        const cover = getPostCover(post);
        return (
          <article class="blog-card" data-href={post.url} tabindex="0" aria-label={`Read ${post.data.title}`}>
            <div>
              <div class="blog-meta">{formatDate(post.data.date)}</div>
              <h2><a href={post.url}>{post.data.title}</a></h2>
              <p>{getPostExcerpt(post)}</p>
            </div>
            {cover.image && <a href={post.url}><img class="blog-cover" src={cover.image} alt={cover.alt} loading="lazy" /></a>}
          </article>
        );
      })}
    </div>
  </section>
</BlogLayout>
