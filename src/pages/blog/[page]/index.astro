---
import BlogLayout from "~/layouts/BlogLayout.astro";
import {
  formatDate,
  getBlogPosts,
  getPostCover,
  getPostExcerpt,
  getPostTags,
  paginate,
  slugify,
} from "~/lib/blog";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const totalPages = Math.ceil(posts.length / 10);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const allPosts = await getBlogPosts();
const page = Number(Astro.params.page);
const { posts, totalPages } = paginate(allPosts, page);
const newerPage = page === 2 ? "/blog/" : `/blog/${page - 1}/`;
const olderPage = page < totalPages ? `/blog/${page + 1}/` : undefined;
---

<BlogLayout title={`BigConfig Blog - Page ${page}`} description="Articles about Agentic DevOps and BigConfig." canonical={`/blog/${page}/`}>
  <section class="blog-shell">
    <p class="blog-eyebrow">Blog</p>
    <h1 class="blog-title">BigConfig Blog</h1>
    <p class="blog-description">Articles about Agentic DevOps, infrastructure packages, Clojure workflows, and self-hosted operations.</p>

    <div class="blog-list">
      {posts.map((post) => {
        const cover = getPostCover(post);
        return (
          <article class="blog-card" data-href={post.url} tabindex="0" aria-label={`Read ${post.data.title}`}>
            <div>
              <div class="blog-meta">{formatDate(post.data.date)}</div>
              <h2><a href={post.url}>{post.data.title}</a></h2>
              <p>{getPostExcerpt(post)}</p>
              <div class="blog-tags">
                {getPostTags(post).map((tag) => <a href={`/blog/tags/${slugify(tag)}/`}>{tag}</a>)}
              </div>
            </div>
            {cover.image && <a href={post.url}><img class="blog-cover" src={cover.image} alt={cover.alt} loading="lazy" /></a>}
          </article>
        );
      })}
    </div>

    <nav class="blog-pagination" aria-label="Blog pagination">
      <a href={newerPage}>Newer</a>
      <span>Page {page} of {totalPages}</span>
      {olderPage ? <a href={olderPage}>Older</a> : <span></span>}
    </nav>
  </section>
</BlogLayout>
