---
import BlogLayout from "~/layouts/BlogLayout.astro";
import {
  authors,
  formatDate,
  getAuthors,
  getBlogPosts,
  getPostCover,
  getPostExcerpt,
  normalizeAuthors,
} from "~/lib/blog";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return getAuthors(posts).map((author) => ({
    params: { author },
  }));
}

const authorId = Astro.params.author ?? "amiorin";
const author = authors[authorId as keyof typeof authors] ?? { name: authorId, title: authorId };
const allPosts = await getBlogPosts();
const posts = allPosts.filter((post) => normalizeAuthors(post.data.authors).includes(authorId));
---

<BlogLayout title={`${author.name} - BigConfig Blog`} description={`Posts by ${author.name}.`} canonical={`/blog/authors/${authorId}/`}>
  <section class="blog-shell">
    <p class="blog-eyebrow">Author</p>
    <h1 class="blog-title">{author.name}</h1>
    <p class="blog-description">{author.title}</p>

    <div class="blog-list">
      {posts.map((post) => {
        const cover = getPostCover(post);
        return (
          <article class="blog-card" data-href={post.url} tabindex="0" aria-label={`Read ${post.data.title}`}>
            <div>
              <div class="blog-meta">{formatDate(post.data.date)}</div>
              <h2><a href={post.url}>{post.data.title}</a></h2>
              <p>{getPostExcerpt(post)}</p>
            </div>
            {cover.image && <a href={post.url}><img class="blog-cover" src={cover.image} alt={cover.alt} loading="lazy" /></a>}
          </article>
        );
      })}
    </div>
  </section>
</BlogLayout>
